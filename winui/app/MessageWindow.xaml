<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolutionWin.MessageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Message">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE715;" FontSize="14" />
                <TextBlock x:Name="TitleText" Text="Message" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Barre de commandes du message -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="8,0,8,0">
            <AppBarButton x:Name="PrevButton" Label="Précédent" Click="OnPrevClick" ToolTipService.ToolTip="Message précédent (Alt+Haut)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72B;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Up" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="NextButton" Label="Suivant" Click="OnNextClick" ToolTipService.ToolTip="Message suivant (Alt+Bas)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72A;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="Down" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ReplyButton" Label="Répondre" Click="OnReplyClick" ToolTipService.ToolTip="Répondre à l'expéditeur (Ctrl+R)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE97A;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="R" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ReplyAllButton" Label="Répondre à tous" Click="OnReplyAllClick" ToolTipService.ToolTip="Répondre à tous (Ctrl+Maj+R)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xEE35;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ForwardButton" Label="Transférer" Click="OnForwardClick" ToolTipService.ToolTip="Transférer le message (Ctrl+F)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72D;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="F" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="ForwardAttachmentButton" Label="Transférer en PJ" Click="OnForwardAsAttachmentClick" ToolTipService.ToolTip="Transférer en pièce jointe .eml (Ctrl+Maj+F)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE723;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="ToggleReadButton" Label="Non lu" Click="OnToggleReadClick" ToolTipService.ToolTip="Marquer comme non lu / lu (Ctrl+U)">
                <AppBarButton.Icon>
                    <FontIcon x:Name="ToggleReadIcon" Glyph="&#xE715;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="U" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="MoveButton" Label="Déplacer" ToolTipService.ToolTip="Déplacer vers un dossier">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8DE;" />
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="MoveMenu" Opening="OnMoveMenuOpening" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="DeleteButton" Label="Supprimer" Click="OnDeleteClick" ToolTipService.ToolTip="Supprimer ce message (Suppr)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="Delete" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="PrintButton" Label="Imprimer" Click="OnPrintClick" ToolTipService.ToolTip="Imprimer ce message (Ctrl+P)">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE749;" />
                </AppBarButton.Icon>
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="P" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="OpenInBrowserButton" Label="Afficher dans le navigateur" Click="OnOpenInBrowserClick" ToolTipService.ToolTip="Ouvrir ce message dans le navigateur web par défaut">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ReadAloudButton" Label="Lire à voix haute" Click="OnReadAloudClick" ToolTipService.ToolTip="Lire à voix haute le message (Synthèse vocale Windows)">
                <AppBarButton.Icon>
                    <FontIcon x:Name="ReadAloudIcon" Glyph="&#xEC92;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <!-- En-tête complet du message -->
        <Border Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1" Padding="20,12,20,12">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SubjectText" Grid.Row="0" Text="(Sans objet)" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FromText" Grid.Column="0" Text="Expéditeur inconnu" FontWeight="Medium" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DateText" Grid.Column="1" Text="" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock x:Name="ToText" Text="À : " Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CcText" Text="Cc : " Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.85" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bandeaux de sécurité et contenu externe -->
        <StackPanel Grid.Row="3" Spacing="0">
            <InfoBar x:Name="SecurityBanner" IsOpen="False" IsClosable="True" Severity="Informational" Margin="8,4,8,4" />
            <InfoBar x:Name="RemoteContentBar" IsOpen="False" IsClosable="True" Severity="Informational"
                     Title="Contenu externe bloqué"
                     Message="Ce message contient des éléments distants qui ont été bloqués pour protéger votre vie privée."
                     Margin="8,4,8,4">
                <InfoBar.Content>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                        <Button Content="Afficher les images" Click="OnAllowRemoteForMessageClick" />
                        <DropDownButton Content="Toujours autoriser">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Pour cet expéditeur" Click="OnTrustSenderClick" />
                                    <MenuFlyoutItem Text="Pour ce domaine" Click="OnTrustDomainClick" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>
        </StackPanel>

        <!-- Barre des pièces jointes -->
        <Border x:Name="AttachmentBar" Grid.Row="4" Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Padding="16,6,16,6" Visibility="Collapsed">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled">
                    <StackPanel x:Name="AttachmentList" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
                </ScrollViewer>
                <Button x:Name="SaveAllAttachmentsButton" Grid.Column="1" Content="Tout enregistrer" VerticalAlignment="Center" Click="OnSaveAllAttachmentsClick" />
            </Grid>
        </Border>

        <!-- Corps du message HTML rendu par WebView2 -->
        <Grid Grid.Row="5">
            <WebView2 x:Name="ReaderWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <ProgressRing x:Name="MessageLoadingRing" IsActive="True" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Barre d'état inférieure -->
        <InfoBar x:Name="StatusBar" Grid.Row="6" IsOpen="False" IsClosable="True" Severity="Informational" Margin="8" />
    </Grid>
</Window>
