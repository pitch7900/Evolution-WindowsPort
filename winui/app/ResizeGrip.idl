namespace EvolutionWin
{
    /* Poignée d'étirement vertical (bord haut ou bas d'une plage ou d'un événement du calendrier) : une grille
     * transparente qui affiche le curseur de redimensionnement vertical au survol
     * (UIElement.ProtectedCursor n'est accessible qu'à une classe dérivée).
     * Le glisser est traité par la fenêtre qui l'héberge. */
    [default_interface]
    runtimeclass ResizeGrip : Microsoft.UI.Xaml.Controls.Grid
    {
        ResizeGrip();
    }
}
