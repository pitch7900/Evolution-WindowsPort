<?xml version="1.0" encoding="utf-8"?>

<Window

    x:Class="EvolutionWin.MainWindow"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="using:Microsoft.UI.Xaml.Controls"

    xmlns:local="using:EvolutionWin"

    Title="Evolution">



    <Window.SystemBackdrop>

        <MicaBackdrop />

    </Window.SystemBackdrop>



    <Grid>

        <!-- raccourcis actifs dans toute la fenêtre, quelle que soit la vue -->

        <Grid.KeyboardAccelerators>

            <KeyboardAccelerator Modifiers="Control,Shift" Key="K" Invoked="OnNewTaskAccelerator" />

            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnSearchAccelerator" />

            <KeyboardAccelerator Key="F1" Invoked="OnKeyboardShortcutsAccelerator" />

        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>

            <RowDefinition Height="48" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <!-- title bar drawn by the app (ExtendsContentIntoTitleBar) -->

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">

                <FontIcon Glyph="&#xE715;" FontSize="14" />

                <TextBlock Text="Evolution" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />

                <!-- barre d'accès rapide, personnalisable (MainWindow::RebuildQuickAccess) ;

                     zone cliquable déclarée à Windows (UpdateTitleBarPassthrough) -->

                <StackPanel x:Name="QuickAccessBar" Orientation="Horizontal" Spacing="2" Margin="12,0,0,0"

                            VerticalAlignment="Center" SizeChanged="OnQuickAccessSizeChanged" />

            </StackPanel>

            <!-- recherche de la fenêtre (Ctrl+E) avec portée sélectionnable :

                 dossier courant, sous-dossiers, compte courant ou tous les comptes -->

            <StackPanel x:Name="SearchContainer" Orientation="Horizontal" Spacing="4"

                        HorizontalAlignment="Center" VerticalAlignment="Center"

                        SizeChanged="OnQuickAccessSizeChanged">

                <ComboBox x:Name="SearchScopeBox" Width="170" VerticalAlignment="Center"

                          SelectionChanged="OnSearchScopeChanged" ToolTipService.ToolTip="Portée de la recherche">

                    <ComboBoxItem Tag="folder" IsSelected="True">

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE8B7;" FontSize="13" />

                            <TextBlock Text="Dossier courant" />

                        </StackPanel>

                    </ComboBoxItem>

                    <ComboBoxItem Tag="subfolders">

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xED43;" FontSize="13" />

                            <TextBlock Text="Sous-dossiers" />

                        </StackPanel>

                    </ComboBoxItem>

                    <ComboBoxItem Tag="account">

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE715;" FontSize="13" />

                            <TextBlock Text="Compte courant" />

                        </StackPanel>

                    </ComboBoxItem>

                    <ComboBoxItem Tag="all">

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE774;" FontSize="13" />

                            <TextBlock Text="Tous les comptes" />

                        </StackPanel>

                    </ComboBoxItem>

                </ComboBox>

                <AutoSuggestBox x:Name="SearchBox" Width="360" VerticalAlignment="Center"

                                PlaceholderText="Rechercher dans le dossier (Ctrl+E)" QueryIcon="Find"

                                TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted"

                                KeyDown="OnSearchKeyDown" />

            </StackPanel>

        </Grid>



        <!-- barre d'icônes fixe entre les modules (comme Outlook) : pas de

             bouton de dépliage, noms en info-bulle, non-lus en badge -->

        <NavigationView

            x:Name="Navigation"

            Grid.Row="1"

            PaneDisplayMode="LeftCompact"

            IsPaneToggleButtonVisible="False"

            IsBackButtonVisible="Collapsed"

            IsSettingsVisible="True"

            SelectionChanged="OnNavigationSelectionChanged"

            ItemInvoked="OnNavigationItemInvoked">



            <NavigationView.MenuItems>

                <NavigationViewItem x:Name="MailItem" Content="Courrier" Tag="mail" IsSelected="True"

                                    ToolTipService.ToolTip="Courrier (Ctrl+1)">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE715;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem Content="Calendrier" Tag="calendar" ToolTipService.ToolTip="Calendrier (Ctrl+2)">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE787;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem Content="Contacts" Tag="contacts" ToolTipService.ToolTip="Contacts (Ctrl+3)">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE77B;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>

                <NavigationViewItem Content="Tâches" Tag="tasks" ToolTipService.ToolTip="Tâches (Ctrl+4)">

                    <NavigationViewItem.Icon>

                        <FontIcon Glyph="&#xE9D5;" />

                    </NavigationViewItem.Icon>

                </NavigationViewItem>

            </NavigationView.MenuItems>







            <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>



            <!-- ruban (vues Courrier, Calendrier, Contacts et Tâches) : onglets (SelectorBar) et

                 barre de commandes de l'onglet choisi ; voir MainWindow::UpdateRibbon -->

            <StackPanel x:Name="Ribbon" Grid.Row="0" Margin="12,4,12,0">

                <SelectorBar x:Name="RibbonTabs" SelectionChanged="OnRibbonTabChanged">

                    <SelectorBarItem Text="Fichier" Tag="file" />

                    <SelectorBarItem Text="Accueil" Tag="home" IsSelected="True" />

                    <SelectorBarItem x:Name="RibbonSendReceiveTab" Text="Envoi/réception" Tag="sendreceive" />

                    <SelectorBarItem x:Name="RibbonFolderTab" Text="Dossier" Tag="folder" />

                    <SelectorBarItem Text="Affichage" Tag="view" />

                </SelectorBar>

                <Border CornerRadius="6" BorderThickness="1" Padding="4,0"

                        Background="{ThemeResource LayerFillColorDefaultBrush}"

                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                <Grid>

                    <CommandBar x:Name="RibbonMailFile" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Enregistrer sous" Click="OnSaveMessageClick" ToolTipService.ToolTip="Enregistrer le message au format .eml (Ctrl+S)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE74E;" /></AppBarButton.Icon>

                            <AppBarButton.KeyboardAccelerators>

                                <KeyboardAccelerator Modifiers="Control" Key="S" />

                            </AppBarButton.KeyboardAccelerators>

                        </AppBarButton>

                        <AppBarButton Label="Imprimer" Click="OnPrintClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE749;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Espace disque" Click="OnRibbonAccountQuotaClick" ToolTipService.ToolTip="Afficher l'espace disque et le quota du compte">
                            <AppBarButton.Icon><FontIcon Glyph="&#xEDA2;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Paramètres" Click="OnRibbonSettingsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="À propos" Click="OnRibbonAboutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>

                        </AppBarButton>
                        <AppBarButton Label="Raccourcis clavier" Click="OnRibbonKeyboardShortcutsClick" ToolTipService.ToolTip="Afficher les raccourcis clavier (F1)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE765;" /></AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Quitter" Click="OnRibbonQuitClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7E8;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonMailHome" Visibility="Visible" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Nouveau message" Click="OnNewMessageClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>

                            <AppBarButton.KeyboardAccelerators>

                                <KeyboardAccelerator Modifiers="Control" Key="N" />

                            </AppBarButton.KeyboardAccelerators>

                        </AppBarButton>

                        <AppBarButton Label="Nouvel élément">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>

                            <AppBarButton.Flyout>

                                <MenuFlyout>

                                    <MenuFlyoutItem Text="Message" Click="OnNewMessageClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE715;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>

                                    <MenuFlyoutItem Text="Rendez-vous" Click="OnNewEventClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE787;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>

                                    <MenuFlyoutItem Text="Réunion (bientôt)" IsEnabled="False"

                                                    ToolTipService.ToolTip="Réunion avec participants et invitations : à venir"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE716;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>

                                    <MenuFlyoutItem Text="Tâche" Click="OnNewTaskClick" KeyboardAcceleratorTextOverride="Ctrl+Maj+K"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>

                                    <MenuFlyoutItem Text="Contact" Click="OnNewContactClick"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77B;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>

                                </MenuFlyout>

                            </AppBarButton.Flyout>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Supprimer" Click="OnDeleteClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Indésirable" Click="OnJunkClick" ToolTipService.ToolTip="Marquer comme indésirable / non indésirable">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Label="Archiver" Click="OnArchiveClick" ToolTipService.ToolTip="Archiver (Retour arrière)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7B8;" /></AppBarButton.Icon>

                        </AppBarButton>
                        <AppBarButton x:Name="RibbonMoveButton" Label="Déplacer" ToolTipService.ToolTip="Déplacer vers un dossier (Ctrl+Maj+V)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="OnMoveMenuOpening" />
                            </AppBarButton.Flyout>
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="V" Invoked="OnMoveFolderAccelerator" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Répondre" Click="OnReplyClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE97A;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Répondre à tous" Click="OnReplyAllClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xEE35;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Transférer" Click="OnForwardClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE72D;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Transférer en PJ" Click="OnForwardAsAttachmentClick" ToolTipService.ToolTip="Transférer en tant que pièce jointe (Ctrl+Maj+F)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE723;" /></AppBarButton.Icon>

                            <AppBarButton.KeyboardAccelerators>

                                <KeyboardAccelerator Modifiers="Control,Shift" Key="F" />

                            </AppBarButton.KeyboardAccelerators>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Lu / Non lu" Click="OnToggleReadClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C3;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Suivi" Click="OnToggleFlagClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7C1;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonCategorizeButton" Label="Catégoriser" ToolTipService.ToolTip="Attribuer des catégories aux messages sélectionnés (Ctrl+F2)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8EC;" /></AppBarButton.Icon>

                            <AppBarButton.Flyout>

                                <MenuFlyout x:Name="RibbonCategorizeMenu" Opening="OnCategorizeMenuOpening" />

                            </AppBarButton.Flyout>

                            <AppBarButton.KeyboardAccelerators>

                                <KeyboardAccelerator Modifiers="Control" Key="F2" Invoked="OnCategorizeQuickAccelerator" />

                            </AppBarButton.KeyboardAccelerators>

                        </AppBarButton>

                        <AppBarSeparator />

                                                <AppBarButton x:Name="RibbonCreateTaskFromMessage" Label="Créer une tâche" Click="OnCreateTaskFromMessageClick" ToolTipService.ToolTip="Créer une tâche à partir du message sélectionné (Ctrl+Maj+T)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                            <AppBarButton.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="T" />
                            </AppBarButton.KeyboardAccelerators>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarElementContainer VerticalAlignment="Center">
                            <AutoSuggestBox x:Name="RibbonQuickContactSearch"
                                            PlaceholderText="Rechercher un contact..."
                                            QueryIcon="Find"
                                            Width="220"
                                            Margin="4,0,4,0"
                                            TextChanged="OnRibbonContactSearchTextChanged"
                                            QuerySubmitted="OnRibbonContactSearchQuerySubmitted"
                                            SuggestionChosen="OnRibbonContactSearchSuggestionChosen"
                                            ToolTipService.ToolTip="Recherche rapide dans le carnet d'adresses (Ctrl+E ou saisie directe)" />
                        </AppBarElementContainer>
                        <AppBarButton x:Name="RibbonAddressBookButton" Label="Carnet d'adresses" Click="OnAddressBookClick" ToolTipService.ToolTip="Ouvrir le carnet d'adresses">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE779;" /></AppBarButton.Icon>
                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonSendReceive" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Envoyer/Recevoir" Click="OnRefreshClick" ToolTipService.ToolTip="Envoyer/Recevoir (F5)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Tous les dossiers" Click="OnRefreshAllClick" ToolTipService.ToolTip="Envoyer/Recevoir tous les dossiers (F9)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Dossier courant" Click="OnRefreshFolderClick" ToolTipService.ToolTip="Mettre à jour le dossier courant (Maj+F9)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonFolder" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Nouveau dossier" Click="OnRibbonNewFolderClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonRenameFolder" Label="Renommer" Click="OnRibbonRenameFolderClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8AC;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonFolderMore" Label="Déplacer / Copier">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8DE;" /></AppBarButton.Icon>

                            <AppBarButton.Flyout>

                                <MenuFlyout x:Name="RibbonFolderMenu" Opening="OnRibbonFolderMenuOpening" />

                            </AppBarButton.Flyout>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Marquer tout comme lu" Click="OnRibbonMarkAllReadClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C3;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonEmptyFolder" Label="Vider le dossier" Click="OnRibbonEmptyFolderClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonDeleteFolder" Label="Supprimer le dossier" Click="OnRibbonDeleteFolderClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8F6;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonMailView" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Tous les messages" Click="OnRibbonReadFilterClick" Tag="all">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8BD;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Non lus" Click="OnRibbonReadFilterClick" Tag="unread">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE715;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Lus" Click="OnRibbonReadFilterClick" Tag="read">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C3;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Trier par">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>

                            <AppBarButton.Flyout>

                                <MenuFlyout Opening="OnSortMenuOpening" />

                            </AppBarButton.Flyout>

                        </AppBarButton>

                        <AppBarToggleButton x:Name="RibbonMailConversationToggle" Label="Conversations"
                                            Click="OnRibbonConversationToggled"
                                            ToolTipService.ToolTip="Afficher les courriels sous forme de conversations pour ce dossier">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8BD;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarButton x:Name="RibbonFolderPaneButton" Label="Volet des dossiers"
                                            ToolTipService.ToolTip="Affichage du volet des dossiers (Normal, Réduit ou Désactivé)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8A0;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="OnFolderPaneMenuOpening" />
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton Label="Volet de lecture">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8A1;" /></AppBarButton.Icon>

                            <AppBarButton.Flyout>

                                <MenuFlyout Opening="OnReadingPaneMenuOpening" />

                            </AppBarButton.Flyout>

                        </AppBarButton>

                        <AppBarButton Label="Rétablir la disposition" Click="OnRibbonResetLayoutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Fermer les éléments ouverts" Click="OnCloseAllSecondaryWindowsClick"
                                      ToolTipService.ToolTip="Ferme toutes les fenêtres de messages et de rédaction ouvertes">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8BB;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarToggleButton x:Name="RibbonMailCompactDensityToggle" Label="Mode compact"

                                            Click="OnRibbonCompactDensityToggled"

                                            ToolTipService.ToolTip="Espacement plus étroit des listes pour afficher plus d'éléments">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8E9;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonMailTodoBarToggle" Label="Volet des tâches"

                                            Click="OnRibbonTodoBarToggled"

                                            ToolTipService.ToolTip="Afficher ou masquer la barre latérale des tâches à faire (Alt+F2)">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonConfidentialToggle" Label="Notifications confidentielles"

                                            Click="OnConfidentialToggled"

                                            ToolTipService.ToolTip="Masquer l'expéditeur et l'objet dans les notifications (présentation, partage d'écran)">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonCalendarFile" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Exporter" Click="OnExportCalendarClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Paramètres" Click="OnRibbonSettingsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="À propos" Click="OnRibbonAboutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>

                        </AppBarButton>
                        <AppBarButton Label="Raccourcis clavier" Click="OnRibbonKeyboardShortcutsClick" ToolTipService.ToolTip="Afficher les raccourcis clavier (F1)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE765;" /></AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Quitter" Click="OnRibbonQuitClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7E8;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonCalendarHome" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Nouvel événement" Click="OnNewEventClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton x:Name="RibbonCalendarFocusButton" Label="Temps individuel (Focus)"
                                      ToolTipService.ToolTip="Planifier un temps de travail individuel (Focus) sans participants"
                                      Click="OnNewFocusEventClick">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8D2;" /></AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Actualiser" Click="OnRefreshCalendarClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Exporter" Click="OnExportCalendarClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonCalendarView" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Aujourd'hui" Click="OnRibbonTodayClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8D1;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Atteindre la date" Click="OnGoToDateClick" ToolTipService.ToolTip="Atteindre une date dans le calendrier (Ctrl+G)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE787;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Jour" Tag="day" Click="OnCalendarPeriodClick" ToolTipService.ToolTip="Affichage Jour (Ctrl+Alt+1)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8BF;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Semaine de travail" Tag="workweek" Click="OnCalendarPeriodClick" ToolTipService.ToolTip="Affichage Semaine de travail (Ctrl+Alt+2)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C0;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Semaine" Tag="week" Click="OnCalendarPeriodClick" ToolTipService.ToolTip="Affichage Semaine (Ctrl+Alt+3)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8C0;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Mois" Tag="month" Click="OnCalendarPeriodClick" ToolTipService.ToolTip="Affichage Mois (Ctrl+Alt+4)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE787;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Liste" Tag="list" Click="OnCalendarPeriodClick" ToolTipService.ToolTip="Affichage Liste (Ctrl+Alt+5)">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE8FD;" /></AppBarButton.Icon>

                        </AppBarButton>

                                                <AppBarButton x:Name="RibbonCalendarTimeScaleButton" Label="Échelle de temps" ToolTipService.ToolTip="Modifier le pas horaire de la grille (15, 30 ou 60 minutes)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE823;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="60 minutes" Tag="60" Click="OnCalendarTimeScaleClick" />
                                    <MenuFlyoutItem Text="30 minutes (défaut)" Tag="30" Click="OnCalendarTimeScaleClick" />
                                    <MenuFlyoutItem Text="15 minutes" Tag="15" Click="OnCalendarTimeScaleClick" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarButton x:Name="RibbonCalendarFolderPaneButton" Label="Volet des dossiers"
                                            ToolTipService.ToolTip="Affichage du volet des dossiers et calendriers (Normal, Réduit ou Désactivé)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE8A0;" /></AppBarButton.Icon>
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="OnFolderPaneMenuOpening" />
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonCalendarSideBySideToggle" Label="Côte à côte"
                                            Click="OnCalendarLayoutModeToggled"
                                            ToolTipService.ToolTip="Afficher les calendriers cochés côte à côte (ou superposés en vue unifiée)">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE90C;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonCalendarCompactDensityToggle" Label="Mode compact"

                                            Click="OnRibbonCompactDensityToggled"

                                            ToolTipService.ToolTip="Espacement plus étroit des listes pour afficher plus d'éléments">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8E9;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonMiniCalendarToggle" Label="Mini-calendrier"
                                            Click="OnRibbonMiniCalendarToggled"
                                            ToolTipService.ToolTip="Afficher ou masquer le mini-calendrier dans le volet latéral gauche">
                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE787;" /></AppBarToggleButton.Icon>
                        </AppBarToggleButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonCalendarTodoBarToggle" Label="Volet des tâches"

                                            Click="OnRibbonTodoBarToggled"

                                            ToolTipService.ToolTip="Afficher ou masquer la barre latérale des tâches à faire (Alt+F2)">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                    </CommandBar>



                    <!-- ruban Contacts -->

                    <CommandBar x:Name="RibbonContactsFile" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Exporter" Click="OnExportContactsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Paramètres" Click="OnRibbonSettingsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="À propos" Click="OnRibbonAboutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Quitter" Click="OnRibbonQuitClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7E8;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonContactsHome" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Nouveau contact" Click="OnNewContactClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Modifier le contact" Click="OnEditContactClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE70F;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Écrire un message" Click="OnComposeToContactClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE715;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="Supprimer le contact" Click="OnDeleteContactClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarButton Label="Exporter" Click="OnExportContactsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonContactsView" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Rétablir la disposition" Click="OnRibbonResetLayoutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE777;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarSeparator />

                        <AppBarToggleButton x:Name="RibbonContactsTodoBarToggle" Label="Volet des tâches"

                                            Click="OnRibbonTodoBarToggled"

                                            ToolTipService.ToolTip="Afficher ou masquer la barre latérale des tâches à faire (Alt+F2)">

                            <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarToggleButton.Icon>

                        </AppBarToggleButton>

                    </CommandBar>



                    <!-- ruban Tâches -->

                    <CommandBar x:Name="RibbonTasksFile" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Paramètres" Click="OnRibbonSettingsClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE713;" /></AppBarButton.Icon>

                        </AppBarButton>

                        <AppBarButton Label="À propos" Click="OnRibbonAboutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>

                        </AppBarButton>
                        <AppBarButton Label="Raccourcis clavier" Click="OnRibbonKeyboardShortcutsClick" ToolTipService.ToolTip="Afficher les raccourcis clavier (F1)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE765;" /></AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarButton Label="Quitter" Click="OnRibbonQuitClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE7E8;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonTasksHome" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Nouvelle tâche" Click="OnNewTaskClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>

                            <AppBarButton.KeyboardAccelerators>

                                <KeyboardAccelerator Modifiers="Control,Shift" Key="K" />

                            </AppBarButton.KeyboardAccelerators>

                        </AppBarButton>

                        <AppBarButton Label="Actualiser" Click="OnRefreshTasksClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                    <CommandBar x:Name="RibbonTasksView" Visibility="Collapsed" DefaultLabelPosition="Right"

                                HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">

                        <AppBarButton Label="Rétablir la disposition" Click="OnRibbonResetLayoutClick">

                            <AppBarButton.Icon><FontIcon Glyph="&#xE777;" /></AppBarButton.Icon>

                        </AppBarButton>

                    </CommandBar>

                </Grid>

                </Border>

            </StackPanel>





            <!-- bandeau d'information des vues Courrier et Calendrier (compte à

                 reconnecter, réponses automatiques…) : MainWindow::ShowBanner -->

            <InfoBar x:Name="InfoBanner" Grid.Row="1" IsOpen="False" IsClosable="True"

                     Margin="12,8,12,0" Closed="OnInfoBannerClosed" />



            <!-- Zone principale d'affichage : Vues superposées + Volet latéral To-Do bar à droite -->

            <Grid x:Name="ViewsArea" Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition x:Name="TodoBarColumn" Width="0" />

                </Grid.ColumnDefinitions>



                <!-- Zone des vues principales (Courrier, Calendrier, Contacts, Tâches, Paramètres) -->

                <Grid Grid.Column="0">

                    <Grid x:Name="MailView">

                <!-- largeurs des dossiers et de la liste : réglées par les

                     séparateurs et mémorisées (MainWindow::RestorePaneWidths) -->

                <Grid.ColumnDefinitions>

                    <ColumnDefinition x:Name="FoldersColumn" Width="260" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition x:Name="ListColumn" Width="420" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>

                <!-- volet de lecture en bas (MainWindow::ApplyReadingPanePosition) :

                     liste en ligne 0, séparateur en ligne 1, lecture en ligne 2 -->

                <Grid.RowDefinitions>

                    <RowDefinition Height="*" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition x:Name="ReaderRow" Height="0" />

                </Grid.RowDefinitions>



                <!-- accounts and folders -->

                <Grid Grid.Column="0" Grid.RowSpan="3" Padding="4,8,4,8">

                    <TreeView x:Name="FolderTree" SelectionMode="Single"

                              ItemInvoked="OnFolderInvoked">

                        <!-- nodes hold a FolderItem in their Content -->

                        <TreeView.ItemTemplate>

                            <DataTemplate>

                                <TreeViewItem>

                                    <Grid ColumnSpacing="8">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="{Binding Content.Glyph}"

                                                  FontFamily="{Binding Content.GlyphFontFamily}"

                                                  FontSize="14" />

                                        <TextBlock Grid.Column="1" Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2" Text="{Binding Content.UnreadText}"

                                                   Margin="0,0,12,0"

                                                   FontWeight="SemiBold"

                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                    </Grid>

                                </TreeViewItem>

                            </DataTemplate>

                        </TreeView.ItemTemplate>

                    </TreeView>

                </Grid>



                <!-- séparateurs déplaçables (double-clic : largeur par défaut) -->

                <local:PaneSplitter x:Name="FoldersSplitter" Grid.Column="1" Grid.RowSpan="3" Width="8" Background="Transparent"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </local:PaneSplitter>

                <local:PaneSplitter x:Name="ListSplitter" Grid.Column="3" Grid.RowSpan="3" Width="8" Background="Transparent"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </local:PaneSplitter>



                <!-- messages of the selected folder -->

                <Grid x:Name="MessageListPane" Grid.Column="2" Grid.RowSpan="3" Padding="0,8,0,0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="16,0,16,8" Spacing="4">

                        <Grid>

                            <TextBlock x:Name="FolderTitle" Text="Courrier" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                            <!-- clic : relève (F5) ; flèche : autres modes (F9, Maj+F9) -->

                            <SplitButton HorizontalAlignment="Right" Click="OnRefreshSplitClick"

                                         ToolTipService.ToolTip="Envoyer/Recevoir (F5)">

                                <FontIcon Glyph="&#xE72C;" FontSize="14" />

                                <!-- actifs même menu fermé : portés par le bouton -->

                                <SplitButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />

                                    <KeyboardAccelerator Key="F9" Invoked="OnRefreshAccelerator" />

                                    <KeyboardAccelerator Modifiers="Shift" Key="F9" Invoked="OnRefreshAccelerator" />

                                </SplitButton.KeyboardAccelerators>

                                <SplitButton.Flyout>

                                    <MenuFlyout Placement="BottomEdgeAlignedRight">

                                        <MenuFlyoutItem Text="Envoyer/Recevoir" Click="OnRefreshClick"

                                                        KeyboardAcceleratorTextOverride="F5" />

                                        <MenuFlyoutItem Text="Envoyer/Recevoir tous les dossiers" Click="OnRefreshAllClick"

                                                        KeyboardAcceleratorTextOverride="F9" />

                                        <MenuFlyoutItem Text="Mettre à jour le dossier courant" Click="OnRefreshFolderClick"

                                                        KeyboardAcceleratorTextOverride="Maj+F9" />

                                    </MenuFlyout>

                                </SplitButton.Flyout>

                            </SplitButton>

                        </Grid>

                        <!-- filtres rapides, combinés avec la recherche (appliqués par ShowMessages) -->

                        <Grid>

                            <SelectorBar x:Name="ReadFilterBar" SelectionChanged="OnQuickFilterChanged">

                                <SelectorBarItem Text="Tous" Tag="all" IsSelected="True" />

                                <SelectorBarItem Text="Non lus" Tag="unread" />

                                <SelectorBarItem Text="Lus" Tag="read" />

                            </SelectorBar>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">

                                <ToggleButton x:Name="FlaggedFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Avec indicateur">

                                    <FontIcon Glyph="&#xE7C1;" FontSize="13" />

                                </ToggleButton>

                                <ToggleButton x:Name="AttachmentFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Avec pièces jointes">

                                    <FontIcon Glyph="&#xE723;" FontSize="13" />

                                </ToggleButton>

                                <ToggleButton x:Name="ThisWeekFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Cette semaine">

                                    <FontIcon Glyph="&#xE787;" FontSize="13" />

                                </ToggleButton>

                            </StackPanel>

                        </Grid>

                        <!-- tri de la liste (mémorisé par dossier) : MainWindow::SortMessages -->

                        <StackPanel Orientation="Horizontal" Spacing="4">

                            <TextBlock Text="Trier par :" VerticalAlignment="Center" Opacity="0.7"

                                       Style="{StaticResource CaptionTextBlockStyle}" />

                            <DropDownButton x:Name="SortButton" Content="Date" Padding="8,2" FontSize="12"

                                            ToolTipService.ToolTip="Critère de tri">

                                <DropDownButton.Flyout>

                                    <MenuFlyout Opening="OnSortMenuOpening" />

                                </DropDownButton.Flyout>

                            </DropDownButton>

                            <Button x:Name="SortDirectionButton" Click="OnSortDirectionClick" Padding="6,4"

                                    ToolTipService.ToolTip="Inverser l'ordre du tri">

                                <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="12" />

                            </Button>

                        </StackPanel>

                    </StackPanel>

                    <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="Extended"

                              SelectionChanged="OnMessageSelectionChanged"

                              DoubleTapped="OnMessageListDoubleTapped"

                              KeyDown="OnMessageListKeyDown"
                              CanDragItems="True"
                              DragItemsStarting="OnMessageListDragItemsStarting">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            </Style>

                        </ListView.ItemContainerStyle>

                    </ListView>

                    <ProgressRing x:Name="ListProgress" Grid.Row="1" IsActive="False"

                                  Width="32" Height="32" />

                </Grid>



                <!-- reading pane -->

                <Rectangle x:Name="ReaderDivider" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Height="1"

                           Margin="0,4,0,4" Visibility="Collapsed" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Grid x:Name="ReaderPane" Grid.Column="4" Grid.RowSpan="3">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel x:Name="MessageHeader" Grid.Row="0" Padding="24,8,24,12" Spacing="4" Visibility="Collapsed">

                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="-12,0,0,4">

                            <AppBarButton Label="Répondre" Click="OnReplyClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE97A;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control" Key="R" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Répondre à tous" Click="OnReplyAllClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xEE35;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Transférer" Click="OnForwardClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE72D;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control" Key="F" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Transférer en PJ" Click="OnForwardAsAttachmentClick" ToolTipService.ToolTip="Transférer en tant que pièce jointe (Ctrl+Maj+F)">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE723;" />

                                </AppBarButton.Icon>

                            </AppBarButton>

                            <AppBarSeparator />

                            <AppBarButton x:Name="ToggleReadButton" Label="Non lu" Click="OnToggleReadClick">

                                <AppBarButton.Icon>

                                    <FontIcon x:Name="ToggleReadIcon" Glyph="&#xE715;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control" Key="U" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton x:Name="ToggleFlagButton" Label="Suivi" Click="OnToggleFlagClick">

                                <AppBarButton.Icon>

                                    <FontIcon x:Name="ToggleFlagIcon" Glyph="&#xE7C1;" />

                                </AppBarButton.Icon>

                            </AppBarButton>

                            <AppBarButton Label="Créer une tâche" Click="OnCreateTaskFromMessageClick" ToolTipService.ToolTip="Créer une tâche à partir de ce message">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE9D5;" />

                                </AppBarButton.Icon>

                            </AppBarButton>

                            <AppBarButton Label="Déplacer">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE8DE;" />

                                </AppBarButton.Icon>

                                <AppBarButton.Flyout>

                                    <MenuFlyout x:Name="MoveMenu" Opening="OnMoveMenuOpening" />

                                </AppBarButton.Flyout>

                            </AppBarButton>

                            <AppBarButton Label="Supprimer" Click="OnDeleteClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE74D;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Key="Delete" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Archiver" Click="OnArchiveClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE7B8;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Key="Back" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarSeparator />

                            <AppBarButton Label="Imprimer" Click="OnPrintClick">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE749;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control" Key="P" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Enregistrer sous" Click="OnSaveMessageClick" ToolTipService.ToolTip="Enregistrer le message au format .eml (Ctrl+S)">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE74E;" />

                                </AppBarButton.Icon>

                                

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control" Key="S" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>

                            <AppBarButton Label="Afficher dans le navigateur" Click="OnOpenInBrowserClick" ToolTipService.ToolTip="Ouvrir ce message dans le navigateur web par défaut">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE774;" />

                                </AppBarButton.Icon>

                            </AppBarButton>

                            <AppBarButton Label="Source MIME" Click="OnViewRawMimeClick" ToolTipService.ToolTip="Afficher le flux brut intégral du message RFC 822 (Ctrl+Maj+U)">

                                <AppBarButton.Icon>

                                    <FontIcon Glyph="&#xE943;" />

                                </AppBarButton.Icon>

                                <AppBarButton.KeyboardAccelerators>

                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="U" />

                                </AppBarButton.KeyboardAccelerators>

                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="Texte brut / HTML" Click="OnTogglePlainTextClick" ToolTipService.ToolTip="Basculer entre texte brut et HTML">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE8C4;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Zoom avant" Click="OnZoomInClick" ToolTipService.ToolTip="Agrandir l'affichage (Ctrl++)">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Add" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="Zoom arrière" Click="OnZoomOutClick" ToolTipService.ToolTip="Réduire l'affichage (Ctrl+-)">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Subtract" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="100 %" Click="OnZoomResetClick" ToolTipService.ToolTip="Réinitialiser le zoom à 100 % (Ctrl+0)">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE777;" /></AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Number0" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>

                            <AppBarButton x:Name="ReadAloudButton" Label="Lire à voix haute" Click="OnReadAloudClick" ToolTipService.ToolTip="Lire à voix haute le message (Synthèse vocale Windows)">

                                <AppBarButton.Icon>

                                    <FontIcon x:Name="ReadAloudIcon" Glyph="&#xEC92;" />

                                </AppBarButton.Icon>

                            </AppBarButton>

                        </CommandBar>

                        <TextBlock x:Name="MessageSubject" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="MessageFrom" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="MessageTo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock x:Name="MessageDate" Style="{StaticResource CaptionTextBlockStyle}" />

                        <InfoBar x:Name="SecurityBar" IsOpen="False" IsClosable="True" Margin="0,4,0,0" />

                        <!-- contenu distant bloqué pour le message affiché -->

                        <InfoBar x:Name="RemoteContentBar" IsOpen="False" IsClosable="True" Margin="0,4,0,0"

                                 Severity="Informational" Title="Contenu externe bloqué">

                            <InfoBar.Content>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">

                                    <Button Content="Afficher les images pour ce message" Click="OnShowRemoteContentClick" />

                                    <Button x:Name="TrustSenderButton" Click="OnTrustSenderClick" />

                                    <Button x:Name="TrustDomainButton" Click="OnTrustDomainClick" />

                                </StackPanel>

                            </InfoBar.Content>

                        </InfoBar>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">

                            <StackPanel x:Name="AttachmentBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />

                        </ScrollViewer>

                    </StackPanel>

                    <Border x:Name="ReaderContainer" Grid.Row="1" Margin="12,0,12,12" Background="White" RequestedTheme="Light" CornerRadius="6" Visibility="Collapsed">

                        <controls:WebView2 x:Name="Reader" RequestedTheme="Light" DefaultBackgroundColor="White" />

                    </Border>

                    <!-- Panneau d'aperçu sécurisé de pièce jointe -->

                    <Border x:Name="AttachmentPreviewContainer" Grid.Row="1" Margin="12,0,12,12" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>

                            <!-- En-tête et actions d'aperçu -->

                            <Border Grid.Row="0" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8,12,8">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                                                        <Button Grid.Column="0" Click="OnCloseAttachmentPreviewClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE72B;" FontSize="12" />
                                            <TextBlock Text="Retour au message" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="PreviewFilenameText" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PreviewSaveButton" Click="OnPreviewSaveClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE74E;" FontSize="12" />
                                                <TextBlock Text="Enregistrer sous..." />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="PreviewOpenButton" Click="OnPreviewOpenClick">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                                <TextBlock Text="Ouvrir" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                </Grid>

                            </Border>

                            <!-- Contenu prévisualisé -->

                            <Grid Grid.Row="1">

                                <!-- Image -->

                                <ScrollViewer x:Name="PreviewImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">

                                    <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />

                                </ScrollViewer>

                                <!-- Texte brut -->

                                <ScrollViewer x:Name="PreviewTextScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">

                                    <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas, monospace" FontSize="13" BorderThickness="0" Background="Transparent" Padding="16" />

                                </ScrollViewer>

                                <!-- Fichier non supporté / fiche sécurisée -->

                                <StackPanel x:Name="PreviewUnsupported" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">

                                    <FontIcon Glyph="&#xE7BA;" FontSize="48" Foreground="{ThemeResource SystemFillColorCautionBrush}" HorizontalAlignment="Center" />

                                    <TextBlock Text="Aucun aperçu direct n'est disponible pour ce type de fichier." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />

                                    <TextBlock Text="Pour votre sécurité, les fichiers exécutables ou non reconnus ne sont pas exécutés." Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                                </StackPanel>

                                <ProgressRing x:Name="PreviewLoadingRing" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            </Grid>

                        </Grid>

                    </Border>

                    <TextBlock x:Name="ReaderPlaceholder" Grid.Row="1"

                               Text="Sélectionnez un message pour le lire"

                               HorizontalAlignment="Center" VerticalAlignment="Center"

                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                </Grid>

            </Grid>



            <!-- Vue Calendrier -->

            <Grid x:Name="CalendarViewPane" Grid.Row="2" Visibility="Collapsed" Padding="24,16,24,16" ColumnSpacing="24">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition x:Name="CalendarSidebarColumn" Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- colonne de gauche : le mini-calendrier et la liste des calendriers -->

                <Grid x:Name="CalendarSidebarPanel" Grid.Column="0" RowSpacing="12">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <CalendarView Grid.Row="0" x:Name="MonthCalendar" SelectionMode="Single" SelectedDatesChanged="OnCalendarDateSelected" />

                    <!-- calendriers par compte : case = affiché, clic sur le nom =

                         calendrier actif des nouveaux événements (MainWindow::LoadCalendarSources) -->

                    <Grid x:Name="CalendarSourcesTitle" Grid.Row="1">
                        <TextBlock Text="Calendriers" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,4,0,0" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Padding="6,2" Click="OnAddCalendarClick" ToolTipService.ToolTip="Ajouter un calendrier (local ou depuis une adresse Internet ICS / webcal)">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="CalendarSourcesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="CalendarSourcesPanel" Spacing="2" />

                    </ScrollViewer>

                </Grid>



                <Grid Grid.Column="1" RowSpacing="12">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <!-- barre de navigation : Aujourd'hui, précédent / suivant, plage

                             affichée, période (MainWindow::LoadEvents) -->

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                            <Button Content="Aujourd'hui" Click="OnRibbonTodayClick" />

                            <Button Click="OnGoToDateClick" ToolTipService.ToolTip="Atteindre une date (Ctrl+G)">

                                <StackPanel Orientation="Horizontal" Spacing="4">

                                    <FontIcon Glyph="&#xE787;" FontSize="12" />

                                    <TextBlock Text="Aller au…" />

                                </StackPanel>

                            </Button>

                            <Button Click="OnCalendarPreviousClick" ToolTipService.ToolTip="Période précédente">

                                <FontIcon Glyph="&#xE76B;" FontSize="12" />

                            </Button>

                            <Button Click="OnCalendarNextClick" ToolTipService.ToolTip="Période suivante">

                                <FontIcon Glyph="&#xE76C;" FontSize="12" />

                            </Button>

                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">

                                <TextBlock x:Name="CalendarHeader" Text="Événements"

                                           Style="{StaticResource SubtitleTextBlockStyle}" />

                                <TextBlock x:Name="ActiveCalendarText" Style="{StaticResource CaptionTextBlockStyle}"

                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            </StackPanel>

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">

                            <SelectorBar x:Name="CalendarPeriodBar" SelectionChanged="OnCalendarPeriodChanged">

                                <SelectorBarItem Text="Jour" Tag="day" />

                                <SelectorBarItem Text="Semaine de travail" Tag="workweek" />

                                <SelectorBarItem Text="Semaine" Tag="week" />

                                <SelectorBarItem Text="Mois" Tag="month" />

                                <SelectorBarItem Text="Liste" Tag="list" />

                            </SelectorBar>

                            <AutoSuggestBox x:Name="CalendarSearchBox" Width="220" PlaceholderText="Filtrer les événements" QueryIcon="Find"
                                            TextChanged="OnCalendarSearchTextChanged" QuerySubmitted="OnCalendarSearchQuerySubmitted" />

                            <Button Click="OnExportCalendarClick" ToolTipService.ToolTip="Exporter un agenda ou une liste de tâches (.ics)">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />

                                    <TextBlock Text="Exporter" />

                                </StackPanel>

                            </Button>

                            <Button Click="OnRefreshCalendarClick" ToolTipService.ToolTip="Actualiser le calendrier">

                                <FontIcon Glyph="&#xE72C;" FontSize="14" />

                            </Button>

                        </StackPanel>

                    </Grid>

                    <ListView x:Name="EventList" Grid.Row="1" SelectionMode="None" Visibility="Collapsed"

                              IsItemClickEnabled="True" ItemClick="OnEventItemClick" />

                    <!-- grille Jour / Semaine / Mois (MainWindow.Calendar.cpp) -->

                    <Grid x:Name="CalendarGridHost" Grid.Row="1" />

                </Grid>

            </Grid>



            <!-- Vue Contacts -->

            <Grid x:Name="ContactsViewPane" Grid.Row="2" Visibility="Collapsed">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="260" />

                    <ColumnDefinition Width="380" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- carnets d'adresses par compte : case = affiché, clic sur le nom =

                     carnet des nouveaux contacts (MainWindow::LoadContactBooks) -->

                <Grid Grid.Column="0" Padding="16,12,8,12" RowSpacing="8"

                      BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <TextBlock Text="Carnets d'adresses" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="ContactBooksPanel" Spacing="2" />

                    </ScrollViewer>

                </Grid>



                <Grid Grid.Column="1" Padding="16,12,16,12" RowSpacing="8"

                      BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">

                        <TextBlock Text="Contacts" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <TextBlock x:Name="ActiveBookText" Style="{StaticResource CaptionTextBlockStyle}"

                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    </StackPanel>

                    <AutoSuggestBox x:Name="ContactSearchBox" Grid.Row="1" PlaceholderText="Rechercher un contact" QueryIcon="Find"

                                    TextChanged="OnContactSearchChanged" QuerySubmitted="OnContactSearchSubmitted" />

                    <ListView x:Name="ContactList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnContactSelectionChanged" />

                </Grid>



                <Grid Grid.Column="2" Padding="32,24,32,24">

                    <StackPanel x:Name="ContactDetailPane" Spacing="12" Visibility="Collapsed">

                        <TextBlock x:Name="ContactNameText" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True" />

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE715;" FontSize="14" />

                            <TextBlock x:Name="ContactEmailText" IsTextSelectionEnabled="True" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE717;" FontSize="14" />

                            <TextBlock x:Name="ContactPhoneText" IsTextSelectionEnabled="True" />

                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <FontIcon Glyph="&#xE731;" FontSize="14" />

                            <TextBlock x:Name="ContactOrgText" IsTextSelectionEnabled="True" />

                        </StackPanel>

                        <TextBlock x:Name="ContactNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"

                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8" />

                        <StackPanel Orientation="Horizontal" Spacing="8">

                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnComposeToContactClick">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE715;" FontSize="14" />

                                    <TextBlock Text="Écrire un message" />

                                </StackPanel>

                            </Button>

                            <Button Click="OnDeleteContactClick">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />

                                    <TextBlock Text="Supprimer le contact" />

                                </StackPanel>

                            </Button>

                            <Button Click="OnEditContactClick">

                                <StackPanel Orientation="Horizontal" Spacing="6">

                                    <FontIcon Glyph="&#xE70F;" FontSize="14" />

                                    <TextBlock Text="Modifier le contact" />

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </StackPanel>

                    <TextBlock x:Name="ContactPlaceholder"

                               Text="Sélectionnez un contact pour afficher sa fiche"

                               HorizontalAlignment="Center" VerticalAlignment="Center"

                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                </Grid>

            </Grid>



            <!-- Vue Tâches -->

            <Grid x:Name="TasksViewPane" Grid.Row="2" Visibility="Collapsed" Padding="24,16,24,16" RowSpacing="12">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tâches" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                    <ComboBox x:Name="TaskListChoice" Grid.Column="1" HorizontalAlignment="Left" MinWidth="220" VerticalAlignment="Center"

                              SelectionChanged="OnTaskListChanged" ToolTipService.ToolTip="Liste de tâches" />

                    <AutoSuggestBox x:Name="TaskSearchBox" Grid.Column="2" HorizontalAlignment="Right" Width="280"

                                    VerticalAlignment="Center" PlaceholderText="Rechercher une tâche (Ctrl+E)..." QueryIcon="Find"

                                    TextChanged="OnTaskSearchTextChanged" QuerySubmitted="OnTaskSearchQuerySubmitted" />

                </Grid>

                <!-- filtres et tri, appliqués localement (ShowTasks) et mémorisés -->

                <Grid Grid.Row="1" ColumnSpacing="16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <SelectorBar x:Name="TaskFilterBar" SelectionChanged="OnTaskFilterChanged">

                        <SelectorBarItem Text="Toutes" Tag="all" IsSelected="True" />

                        <SelectorBarItem Text="Aujourd'hui" Tag="today" />

                        <SelectorBarItem Text="En retard" Tag="overdue" />

                        <SelectorBarItem Text="Cette semaine" Tag="week" />

                        <SelectorBarItem Text="Sans date" Tag="nodate" />

                    </SelectorBar>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                        <ComboBox x:Name="TaskSortChoice" SelectionChanged="OnTaskSortChanged" ToolTipService.ToolTip="Ordre des tâches">

                            <x:String>Trier par échéance</x:String>

                            <x:String>Trier par priorité</x:String>

                        </ComboBox>

                        <CheckBox x:Name="ShowCompletedTasksBox" Content="Afficher les tâches terminées"

                                  IsChecked="True" Click="OnShowCompletedTasksClick" />

                    </StackPanel>

                </Grid>

                <ListView x:Name="TaskList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTaskItemClick">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                        </Style>

                    </ListView.ItemContainerStyle>

                </ListView>

                <ProgressRing x:Name="TaskProgress" Grid.Row="2" IsActive="False" Width="32" Height="32" />

            </Grid>



            <!-- Vue Paramètres (Modèle Paramètres de Windows 11) -->

            <Grid x:Name="SettingsViewPane" Grid.Row="2" Visibility="Collapsed">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="280" />

                    <ColumnDefinition Width="1" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- Volet gauche : Navigation par catégories et recherche rapide -->

                <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,20,16,16">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>



                    <TextBlock Grid.Row="0" Text="Paramètres" Style="{StaticResource TitleTextBlockStyle}" Margin="8,0,0,16" />



                    <!-- Recherche rapide -->

                    <AutoSuggestBox Grid.Row="1" x:Name="SettingsSearchBox"

                                    PlaceholderText="Rechercher un paramètre"

                                    QueryIcon="Find"

                                    TextChanged="OnSettingsSearchTextChanged"

                                    SuggestionChosen="OnSettingsSearchSuggestionChosen"

                                    Margin="4,0,4,12" />



                    <!-- Liste des catégories -->

                    <ListView Grid.Row="2" x:Name="SettingsNavList"

                              SelectionMode="Single"

                              SelectionChanged="OnSettingsNavSelectionChanged">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter Property="CornerRadius" Value="6" />

                                <Setter Property="Margin" Value="0,2,0,2" />

                                <Setter Property="Padding" Value="12,10,12,10" />

                            </Style>

                        </ListView.ItemContainerStyle>

                        <ListViewItem Tag="accounts">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Comptes" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="mail">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE715;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Courrier" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="calendar">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE787;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Calendrier" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="contacts">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE716;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Contacts" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="tasks">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE9D5;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Tâches" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="notifications">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Notifications" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="appearance">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Apparence" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="privacy">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE72E;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Confidentialité et sécurité" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="update">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE777;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Mise à jour" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="advanced">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE90F;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Avancé" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                        <ListViewItem Tag="about">

                            <StackPanel Orientation="Horizontal" Spacing="12">

                                <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="À propos" VerticalAlignment="Center" />

                            </StackPanel>

                        </ListViewItem>

                    </ListView>

                </Grid>



                <!-- Séparateur vertical -->

                <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Width="1" />



                <!-- Volet droit : Contenu de la catégorie active -->

                <Grid Grid.Column="2" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>



                    <!-- En-tête avec fil d'Ariane -->

                    <StackPanel Grid.Row="0" Padding="36,24,36,12" Spacing="4">

                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">

                            <HyperlinkButton Content="Paramètres" Click="OnSettingsBreadcrumbRootClick"

                                             Padding="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                            <TextBlock x:Name="SettingsBreadcrumbCategory" Text="Comptes"

                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />

                        </StackPanel>

                        <TextBlock x:Name="SettingsCategoryTitle" Text="Comptes" Style="{StaticResource TitleTextBlockStyle}" />

                        <TextBlock x:Name="SettingsCategoryDescription"

                                   Text="Gérez vos comptes de messagerie Microsoft 365, Exchange, Gmail et IMAP / SMTP."

                                   Style="{StaticResource CaptionTextBlockStyle}"

                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    </StackPanel>



                    <!-- Conteneur avec défilement des différentes catégories -->

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,0,36,36">

                        <StackPanel Spacing="24">



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 1 : COMPTES                                   -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryAccounts" Visibility="Visible" Spacing="16">

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE710;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Ajouter un compte de messagerie" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Configurez une nouvelle boîte aux lettres Exchange Online, Gmail, Outlook ou IMAP / SMTP."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnAddAccountClick">

                                            <StackPanel Orientation="Horizontal" Spacing="8">

                                                <FontIcon Glyph="&#xE710;" FontSize="14" />

                                                <TextBlock Text="Ajouter un compte" />

                                            </StackPanel>

                                        </Button>

                                    </Grid>

                                </Border>

                                <TextBlock Text="Comptes configurés" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

                                <ListView x:Name="AccountList" SelectionMode="None" />

                            </StackPanel>



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 2 : COURRIER                                  -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryMail" Visibility="Collapsed" Spacing="16">

                                <TextBlock Text="Réception et synchronisation" Style="{StaticResource SubtitleTextBlockStyle}" />



                                <!-- Relève automatique -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Vérification automatique du nouveau courrier" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Fréquence à laquelle l'application interroge les serveurs pour relever vos messages."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ComboBox Grid.Column="2" x:Name="MailSyncIntervalCombo" Tag="mail.sync-interval"

                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="160">

                                            <ComboBoxItem Content="Toutes les minutes" Tag="1" />

                                            <ComboBoxItem Content="Toutes les 5 minutes" Tag="5" />

                                            <ComboBoxItem Content="Toutes les 15 minutes" Tag="15" />

                                            <ComboBoxItem Content="Toutes les 30 minutes" Tag="30" />

                                            <ComboBoxItem Content="Manuellement uniquement" Tag="0" />

                                        </ComboBox>

                                    </Grid>

                                </Border>



                                <!-- Relève au démarrage -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE756;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Relever le courrier au démarrage" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Synchroniser immédiatement tous les comptes dès l'ouverture d'EvolutionWin."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="MailSyncOnStartupSwitch" Tag="mail.sync-on-startup"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <TextBlock Text="Lecture et affichage" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />



                                <!-- Marquer comme lu -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

