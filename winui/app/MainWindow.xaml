                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Réduire dans la zone de notification Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Masquer dans la boîte à miniatures près de l'horloge au lieu de quitter complètement."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="AppearanceMinimizeToTraySwitch" Tag="appearance.minimize-to-tray"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>

                                <!-- Démarrage automatique avec Windows -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Démarrer automatiquement avec Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Lance EvolutionWin dès l'ouverture de votre session utilisateur Windows."
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="AppearanceAutoStartupSwitch" Tag="general.auto-startup"
                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                            </StackPanel>



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 8 : CONFIDENTIALITÉ & SÉCURITÉ                -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryPrivacy" Visibility="Collapsed" Spacing="16">

                                <TextBlock Text="Contenu externe et suivi des messages" Style="{StaticResource SubtitleTextBlockStyle}" />

                                <TextBlock Text="Les images et styles distants d'un message (dont les pixels espions) révèlent à l'expéditeur que vous l'avez ouvert, à quel moment et depuis quelle adresse IP."

                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"

                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />



                                <!-- Mode de chargement du contenu distant (contrôle existant conservé) -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="64">

                                    <StackPanel Spacing="8">

                                        <TextBlock Text="Charger le contenu externe des messages" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                        <RadioButtons x:Name="RemoteContentModeChoice" SelectionChanged="OnRemoteContentModeChanged">

                                            <x:String>Jamais</x:String>

                                            <x:String>Expéditeurs et domaines de confiance seulement</x:String>

                                            <x:String>Toujours</x:String>

                                        </RadioButtons>

                                    </StackPanel>

                                </Border>



                                <!-- Masquer les extraits de texte dans la liste -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE890;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Masquer l'extrait des messages dans la liste" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Ne pas afficher les lignes d'aperçu du texte des messages pour une discrétion totale."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="PrivacyHideSnippetsSwitch" Tag="privacy.hide-snippets"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <TextBlock Text="Expéditeurs et domaines de confiance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

                                <TextBlock x:Name="TrustedSendersEmpty"

                                           Text="Aucun expéditeur ni domaine de confiance. Utilisez le bandeau « Contenu externe bloqué » au-dessus d'un message pour en ajouter."

                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"

                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ListView x:Name="TrustedSenderList" SelectionMode="None" />

                            </StackPanel>



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 9 : MISE À JOUR                               -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryUpdate" Visibility="Collapsed" Spacing="16">

                                <TextBlock Text="Recherche de nouvelles versions" Style="{StaticResource SubtitleTextBlockStyle}" />



                                <!-- Recherche automatique -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Vérifier les mises à jour au démarrage" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Interroger GitHub Releases au lancement pour vous avertir des nouvelles versions."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="UpdateAutoCheckSwitch" Tag="update.auto-check"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <!-- Canal de mise à jour -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Canal de mise à jour" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Choisissez entre les publications stables recommandées ou les pré-versions de test."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ComboBox Grid.Column="2" x:Name="UpdateChannelCombo" Tag="update.channel"

                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="160">

                                            <ComboBoxItem Content="Stable (Recommandé)" Tag="stable" />

                                            <ComboBoxItem Content="Versions bêta préliminaires" Tag="beta" />

                                        </ComboBox>

                                    </Grid>

                                </Border>



                                <!-- Bouton de vérification manuelle -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Vérifier la disponibilité immédiatement" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Version actuelle installée : 0.9.6 (Architecture Windows x64)"

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Rechercher des mises à jour" Style="{StaticResource AccentButtonStyle}"

                                                Click="OnCheckUpdateNowClick" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>

                            </StackPanel>



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 10 : AVANCÉ                                   -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryAdvanced" Visibility="Collapsed" Spacing="16">

                                <TextBlock Text="Données locales et stockage" Style="{StaticResource SubtitleTextBlockStyle}" />



                                <!-- Emplacement des données -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Dossier des données et préférences locales" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="%LOCALAPPDATA%\EvolutionWin (fichier settings.json, profils et caches)"

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Ouvrir le dossier" Click="OnOpenDataFolderClick" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <!-- Vider le cache WebView2 -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Cache de rendu HTML (WebView2)" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Libérer l'espace disque en purgeant les fichiers temporaires et les caches de lecture."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Vider le cache" Click="OnClearWebViewCacheClick" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <TextBlock Text="Diagnostics et réinitialisation" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />



                                <!-- Journalisation détaillée -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE90F;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Journalisation détaillée (Debug log)" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Enregistrer des traces détaillées dans evolution.log pour aider au diagnostic d'anomalies."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="AdvancedVerboseLogSwitch" Tag="advanced.verbose-log"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <!-- Réinitialiser tous les paramètres -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE7A7;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Rétablir tous les paramètres par défaut" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Restaure les réglages initiaux de l'application sans toucher à vos comptes ni à vos courriels."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Réinitialiser" Click="OnResetAllSettingsClick" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>

                            </StackPanel>



                            <!-- ======================================================== -->

                            <!-- CATÉGORIE 11 : À PROPOS                                 -->

                            <!-- ======================================================== -->

                            <StackPanel x:Name="SettingsCategoryAbout" Visibility="Collapsed" Spacing="16">

                                <!-- Carte 1 : En-tête version et recherche de mise à jour -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Logo de l'application -->
                                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Image x:Name="AboutAppLogo" Source="Assets/EvolutionWin.png" Width="64" Height="64" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Titre et informations de version -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Evolution pour Windows" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                                                <TextBlock x:Name="AboutVersionText" Text="Version 0.9.6"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="AboutUpdateStatusText" Text="Recherche de mises à jour…"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Action manuelle de vérification -->
                                            <Button Grid.Column="2" x:Name="AboutCheckUpdateButton" VerticalAlignment="Center" Click="OnAboutCheckUpdateClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                                    <TextBlock Text="Rechercher des mises à jour" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Bandeau d'information si une mise à jour est trouvée ou en cas d'erreur -->
                                        <InfoBar x:Name="AboutUpdateInfoBar" IsClosable="True" IsOpen="False" />
                                    </StackPanel>
                                </Border>

                                <!-- Carte 2 : Présentation et mentions légales -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Présentation et mentions légales" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Client de messagerie, calendrier et contacts complet natif pour Windows 11, bâti sur le moteur robuste de GNOME Evolution (evolution-data-server, Camel), Windows App SDK et WinUI 3. Logiciel libre sous licence GNU LGPL 2.1 ou ultérieure."
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                                            <HyperlinkButton Content="Dépôt GitHub du portage" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort" Padding="0" />
                                            <HyperlinkButton Content="Journal des modifications (CHANGELOG)" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort/blob/main/CHANGELOG.md" Padding="0" />
                                            <HyperlinkButton Content="Signaler une anomalie" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort/issues" Padding="0" />
                                            <HyperlinkButton Content="Dépôt amont GNOME Evolution" NavigateUri="https://github.com/GNOME/evolution" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Carte 3 : Composants du moteur et environnement technique -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Composants et environnement système" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="Versions des bibliothèques intégrées et du système d'exploitation pour le diagnostic."
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="AboutCopySystemInfoButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnAboutCopySystemInfoClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                    <TextBlock x:Name="AboutCopySystemInfoButtonText" Text="Copier les informations" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Grille des composants (peuplée dynamiquement) -->
                                        <Grid x:Name="AboutComponentsGrid" ColumnSpacing="24" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>



                        </StackPanel>

                    </ScrollViewer>

                </Grid>

            </Grid>

                </Grid>



                <!-- Séparateur redimensionnable pour la barre latérale des tâches -->

                <local:PaneSplitter x:Name="TodoBarSplitter" Grid.Column="1" Width="6" Background="Transparent"

                                    Visibility="Collapsed"

                                    PointerPressed="OnTodoBarSplitterPointerPressed"

                                    PointerMoved="OnTodoBarSplitterPointerMoved"

                                    PointerReleased="OnTodoBarSplitterPointerReleased"

                                    PointerCaptureLost="OnTodoBarSplitterPointerCaptureLost">

                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </local:PaneSplitter>



                <!-- Volet latéral des tâches (To-Do Bar façon Outlook) -->

                <Border x:Name="TodoBarPane" Grid.Column="2" Visibility="Collapsed"

                        Background="{ThemeResource LayerFillColorDefaultBrush}"

                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                        BorderThickness="1,0,0,0">

                    <Grid Padding="12,12,12,12" RowSpacing="10">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>



                        <!-- En-tête : Titre + Actions rapides -->

                        <Grid Grid.Row="0">

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                <FontIcon Glyph="&#xE9D5;" FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                                <TextBlock Text="Tâches à faire" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">

                                <Button ToolTipService.ToolTip="Actualiser les tâches" Click="OnTodoBarRefreshClick"

                                        Padding="6,4" Background="Transparent" BorderThickness="0">

                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />

                                </Button>

                                <Button ToolTipService.ToolTip="Fermer le volet des tâches (Alt+F2)" Click="OnTodoBarCloseClick"

                                        Padding="6,4" Background="Transparent" BorderThickness="0">

                                    <FontIcon Glyph="&#xE711;" FontSize="12" />

                                </Button>

                            </StackPanel>

                        </Grid>



                        <!-- Champ d'ajout rapide de tâche -->

                        <Grid Grid.Row="1" ColumnSpacing="6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*" />

                                <ColumnDefinition Width="Auto" />

                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TodoBarQuickInput" PlaceholderText="Nouvelle tâche rapide... (Entrée)"

                                     KeyDown="OnTodoBarQuickInputKeyDown" />

                            <Button Grid.Column="1" ToolTipService.ToolTip="Ajouter cette tâche" Click="OnTodoBarQuickAddClick">

                                <FontIcon Glyph="&#xE710;" FontSize="12" />

                            </Button>

                        </Grid>



                        <!-- Liste des tâches en cours -->

                        <ListView x:Name="TodoBarListView" Grid.Row="2" SelectionMode="None"

                                  IsItemClickEnabled="True" ItemClick="OnTodoBarItemClick"

                                  Padding="0,2,0,2" />



                        <!-- Pied du volet : Compteur et lien Voir toutes les tâches -->

                        <Grid Grid.Row="3" Margin="0,4,0,0">

                            <TextBlock x:Name="TodoBarCountText" Text="Aucune tâche en attente"

                                       Style="{StaticResource CaptionTextBlockStyle}"

                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                       VerticalAlignment="Center" />

                            <HyperlinkButton Content="Voir tout (Ctrl+4)" Click="OnTodoBarViewAllClick"

                                             HorizontalAlignment="Right" Padding="4,2" />

                        </Grid>

                    </Grid>

                </Border>

            </Grid>

            </Grid>

        </NavigationView>



        <!-- status / notifications temporaires -->

        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" Margin="8,0,8,4" />



        <!-- barre d'état permanente (style Outlook) : compteurs, progression, état des connexions -->

        <Border Grid.Row="3" Background="{ThemeResource LayerFillColorDefaultBrush}"

                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"

                Padding="12,4,12,4" MinHeight="32">

            <Grid VerticalAlignment="Center">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <!-- À gauche : statut du dossier / nombre d'éléments -->

                <TextBlock x:Name="FolderStatusText" Grid.Column="0"

                           Text="Tous les dossiers sont à jour" VerticalAlignment="Center"

                           Style="{StaticResource CaptionTextBlockStyle}" />



                <!-- Au centre / droite : barre de progression discrète lors de la synchronisation -->

                <StackPanel x:Name="StatusBarProgressPanel" Grid.Column="2" Orientation="Horizontal"

                            Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed">

                    <ProgressBar x:Name="StatusBarProgressBar" Width="140" Height="4"

                                 IsIndeterminate="True" VerticalAlignment="Center" />

                    <TextBlock x:Name="StatusBarProgressText" Text="Synchronisation…"

                               Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />

                    <Button x:Name="StatusBarCancelButton" Style="{StaticResource SubtleButtonStyle}"
                            Padding="4,2,4,2" Click="OnCancelSyncClick" ToolTipService.ToolTip="Annuler l'opération en cours">
                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                    </Button>

                </StackPanel>



                <!-- À droite : notifications et indicateur d'état des connexions -->

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Menu déroulant des notifications récentes -->

                    <Button x:Name="NotificationsButton"

                            Padding="6,3,6,3" VerticalAlignment="Center"

                            ToolTipService.ToolTip="Notifications reçues">

                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                            <FontIcon Glyph="&#xEA8F;" FontSize="14" VerticalAlignment="Center" />

                            <InfoBadge x:Name="NotificationsBadge" Value="0" Visibility="Collapsed"

                                       Style="{StaticResource AttentionValueInfoBadgeStyle}" />

                        </StackPanel>

                        <Button.Flyout>

                            <Flyout x:Name="NotificationsFlyout">

                                <StackPanel Width="340" Spacing="8">

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Notifications" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                                        <Button x:Name="ClearAllNotificationsButton" Grid.Column="1"

                                                Content="Tout effacer" Style="{StaticResource SubtleButtonStyle}"

                                                Click="OnClearAllNotificationsClick" />

                                    </Grid>

                                    <MenuFlyoutSeparator />

                                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel Spacing="6">

                                            <TextBlock x:Name="NoNotificationsText" Text="Aucune notification"

                                                       Style="{StaticResource CaptionTextBlockStyle}"

                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                                       HorizontalAlignment="Center" Margin="0,16,0,16" />

                                            <StackPanel x:Name="NotificationsPanel" Spacing="6" />

                                        </StackPanel>

                                    </ScrollViewer>

                                </StackPanel>

                            </Flyout>

                        </Button.Flyout>

                    </Button>

                <Button x:Name="ConnectionStatusButton"

                        Click="OnConnectionStatusButtonClick"

                        Padding="8,3,8,3" VerticalAlignment="Center"

                        ToolTipService.ToolTip="Afficher l'état des connexions réseau">

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                        <Ellipse x:Name="ConnectionStatusDot" Width="8" Height="8"

                                 Fill="#107C41" VerticalAlignment="Center" />

                        <TextBlock x:Name="ConnectionStatusLabel" Text="Connecté"

                                   Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />

                    </StackPanel>

                    <Button.Flyout>

                        <Flyout x:Name="ConnectionStatusFlyout">

                            <StackPanel Width="340" Spacing="12">

                                <TextBlock Text="État des connexions" Style="{StaticResource SubtitleTextBlockStyle}" />

                                <StackPanel x:Name="ConnectionAccountsPanel" Spacing="8">

                                    <!-- Rempli dynamiquement par RefreshConnectionAccountsList -->

                                </StackPanel>

                                <MenuFlyoutSeparator />

                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">

                                    <Button x:Name="RetryConnectionsButton" Content="Vérifier maintenant"

                                            Click="OnRetryConnectionsClick" />

                                    <Button x:Name="ToggleOfflineButton" Content="Travailler hors connexion"

                                            Click="OnToggleOfflineClick" />

                                </StackPanel>

                            </StackPanel>

                        </Flyout>

                    </Button.Flyout>

                </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</Window>

