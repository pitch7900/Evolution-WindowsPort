<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EvolutionWin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:EvolutionWin"
    Title="Evolution">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <!-- raccourcis actifs dans toute la fenêtre, quelle que soit la vue -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control,Shift" Key="K" Invoked="OnNewTaskAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- title bar drawn by the app (ExtendsContentIntoTitleBar) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <FontIcon Glyph="&#xE715;" FontSize="14" />
                <TextBlock Text="Evolution" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            SelectionChanged="OnNavigationSelectionChanged"
            ItemInvoked="OnNavigationItemInvoked">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="MailItem" Content="Courrier" Tag="mail" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Calendrier" Tag="calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Contacts" Tag="contacts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tâches" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <!-- ouvre une boîte de dialogue : la vue affichée ne change pas -->
                <NavigationViewItem Content="À propos" Tag="about" SelectsOnInvoked="False"
                                    ToolTipService.ToolTip="À propos d'Evolution">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
            <Grid x:Name="MailView">
                <!-- largeurs des dossiers et de la liste : réglées par les
                     séparateurs et mémorisées (MainWindow::RestorePaneWidths) -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FoldersColumn" Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ListColumn" Width="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- accounts and folders -->
                <Grid Grid.Column="0" Padding="4,8,4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" HorizontalAlignment="Stretch" Margin="8,0,8,8"
                            Style="{StaticResource AccentButtonStyle}" Click="OnNewMessageClick">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Nouveau message" />
                        </StackPanel>
                    </Button>
                    <TreeView x:Name="FolderTree" Grid.Row="1" SelectionMode="Single"
                              ItemInvoked="OnFolderInvoked">
                        <!-- nodes hold a FolderItem in their Content -->
                        <TreeView.ItemTemplate>
                            <DataTemplate>
                                <TreeViewItem>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{Binding Content.Glyph}" FontSize="14" />
                                        <TextBlock Grid.Column="1" Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Content.UnreadText}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </TreeViewItem>
                            </DataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>

                <!-- séparateurs déplaçables (double-clic : largeur par défaut) -->
                <local:PaneSplitter x:Name="FoldersSplitter" Grid.Column="1" Width="6" Background="Transparent"
                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"
                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"
                                    DoubleTapped="OnSplitterDoubleTapped">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                </local:PaneSplitter>
                <local:PaneSplitter x:Name="ListSplitter" Grid.Column="3" Width="6" Background="Transparent"
                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"
                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"
                                    DoubleTapped="OnSplitterDoubleTapped">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                </local:PaneSplitter>

                <!-- messages of the selected folder -->
                <Grid Grid.Column="2" Padding="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Padding="16,0,16,8" Spacing="4">
                        <Grid>
                            <TextBlock x:Name="FolderTitle" Text="Courrier" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            <!-- clic : relève (F5) ; flèche : autres modes (F9, Maj+F9) -->
                            <SplitButton HorizontalAlignment="Right" Click="OnRefreshSplitClick"
                                         ToolTipService.ToolTip="Envoyer/Recevoir (F5)">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <!-- actifs même menu fermé : portés par le bouton -->
                                <SplitButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
                                    <KeyboardAccelerator Key="F9" Invoked="OnRefreshAccelerator" />
                                    <KeyboardAccelerator Modifiers="Shift" Key="F9" Invoked="OnRefreshAccelerator" />
                                </SplitButton.KeyboardAccelerators>
                                <SplitButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Text="Envoyer/Recevoir" Click="OnRefreshClick"
                                                        KeyboardAcceleratorTextOverride="F5" />
                                        <MenuFlyoutItem Text="Envoyer/Recevoir tous les dossiers" Click="OnRefreshAllClick"
                                                        KeyboardAcceleratorTextOverride="F9" />
                                        <MenuFlyoutItem Text="Mettre à jour le dossier courant" Click="OnRefreshFolderClick"
                                                        KeyboardAcceleratorTextOverride="Maj+F9" />
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                            </SplitButton>
                        </Grid>
                        <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Rechercher dans ce dossier" QueryIcon="Find"
                                        TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchQuerySubmitted" />
                        <!-- filtres rapides, combinés avec la recherche (appliqués par ShowMessages) -->
                        <Grid>
                            <SelectorBar x:Name="ReadFilterBar" SelectionChanged="OnQuickFilterChanged">
                                <SelectorBarItem Text="Tous" Tag="all" IsSelected="True" />
                                <SelectorBarItem Text="Non lus" Tag="unread" />
                                <SelectorBarItem Text="Lus" Tag="read" />
                            </SelectorBar>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <ToggleButton x:Name="FlaggedFilterButton" Click="OnQuickFilterToggled"
                                              Padding="8,4" ToolTipService.ToolTip="Avec indicateur">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="AttachmentFilterButton" Click="OnQuickFilterToggled"
                                              Padding="8,4" ToolTipService.ToolTip="Avec pièces jointes">
                                    <FontIcon Glyph="&#xE723;" FontSize="13" />
                                </ToggleButton>
                                <ToggleButton x:Name="ThisWeekFilterButton" Click="OnQuickFilterToggled"
                                              Padding="8,4" ToolTipService.ToolTip="Cette semaine">
                                    <FontIcon Glyph="&#xE787;" FontSize="13" />
                                </ToggleButton>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="Extended"
                              SelectionChanged="OnMessageSelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    <ProgressRing x:Name="ListProgress" Grid.Row="1" IsActive="False"
                                  Width="32" Height="32" />
                </Grid>

                <!-- reading pane -->
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="MessageHeader" Grid.Row="0" Padding="24,8,24,12" Spacing="4" Visibility="Collapsed">
                        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Margin="-12,0,0,4">
                            <AppBarButton Label="Répondre" Click="OnReplyClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE97A;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="R" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="Répondre à tous" Click="OnReplyAllClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xEE35;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="R" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="Transférer" Click="OnForwardClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72D;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="F" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton x:Name="ToggleReadButton" Label="Non lu" Click="OnToggleReadClick">
                                <AppBarButton.Icon>
                                    <FontIcon x:Name="ToggleReadIcon" Glyph="&#xE715;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="U" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton x:Name="ToggleFlagButton" Label="Suivi" Click="OnToggleFlagClick">
                                <AppBarButton.Icon>
                                    <FontIcon x:Name="ToggleFlagIcon" Glyph="&#xE7C1;" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="Déplacer">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8DE;" />
                                </AppBarButton.Icon>
                                <AppBarButton.Flyout>
                                    <MenuFlyout x:Name="MoveMenu" Opening="OnMoveMenuOpening" />
                                </AppBarButton.Flyout>
                            </AppBarButton>
                            <AppBarButton Label="Supprimer" Click="OnDeleteClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Delete" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarSeparator />
                            <AppBarButton Label="Imprimer" Click="OnPrintClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE749;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="P" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                            <AppBarButton Label="Enregistrer sous" Click="OnSaveMessageClick">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE792;" />
                                </AppBarButton.Icon>
                                <AppBarButton.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </AppBarButton.KeyboardAccelerators>
                            </AppBarButton>
                        </CommandBar>
                        <TextBlock x:Name="MessageSubject" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="MessageFrom" Style="{StaticResource BodyStrongTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="MessageTo" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="MessageDate" Style="{StaticResource CaptionTextBlockStyle}" />
                        <InfoBar x:Name="SecurityBar" IsOpen="False" IsClosable="True" Margin="0,4,0,0" />
                        <!-- contenu distant bloqué pour le message affiché -->
                        <InfoBar x:Name="RemoteContentBar" IsOpen="False" IsClosable="True" Margin="0,4,0,0"
                                 Severity="Informational" Title="Contenu externe bloqué">
                            <InfoBar.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                    <Button Content="Afficher les images pour ce message" Click="OnShowRemoteContentClick" />
                                    <Button x:Name="TrustSenderButton" Click="OnTrustSenderClick" />
                                    <Button x:Name="TrustDomainButton" Click="OnTrustDomainClick" />
                                </StackPanel>
                            </InfoBar.Content>
                        </InfoBar>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                            <StackPanel x:Name="AttachmentBar" Orientation="Horizontal" Spacing="8" Visibility="Collapsed" />
                        </ScrollViewer>
                    </StackPanel>
                    <Border x:Name="ReaderContainer" Grid.Row="1" Margin="12,0,12,12" Background="White" RequestedTheme="Light" CornerRadius="6" Visibility="Collapsed">
                        <controls:WebView2 x:Name="Reader" RequestedTheme="Light" DefaultBackgroundColor="White" />
                    </Border>
                    <TextBlock x:Name="ReaderPlaceholder" Grid.Row="1"
                               Text="Sélectionnez un message pour le lire"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>

            <!-- Vue Calendrier -->
            <Grid x:Name="CalendarViewPane" Visibility="Collapsed" Padding="24,16,24,16" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <Button HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnNewEventClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Nouvel événement" />
                        </StackPanel>
                    </Button>
                    <CalendarView x:Name="MonthCalendar" SelectionMode="Single" SelectedDatesChanged="OnCalendarDateSelected" />
                </StackPanel>

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="CalendarHeader" Text="Événements" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Click="OnExportCalendarClick" ToolTipService.ToolTip="Exporter un agenda ou une liste de tâches (.ics)">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                    <TextBlock Text="Exporter" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnRefreshCalendarClick" ToolTipService.ToolTip="Actualiser le calendrier">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="EventList" Grid.Row="1" SelectionMode="None" />
                </Grid>
            </Grid>

            <!-- Vue Contacts -->
            <Grid x:Name="ContactsViewPane" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Padding="16,12,16,12" RowSpacing="8"
                      BorderThickness="0,0,1,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="Contacts" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Click="OnExportContactsClick" ToolTipService.ToolTip="Exporter les contacts au format vCard (.vcf)">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnNewContactClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Nouveau contact" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <AutoSuggestBox x:Name="ContactSearchBox" Grid.Row="1" PlaceholderText="Rechercher un contact" QueryIcon="Find"
                                    TextChanged="OnContactSearchChanged" QuerySubmitted="OnContactSearchSubmitted" />
                    <ListView x:Name="ContactList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnContactSelectionChanged" />
                </Grid>

                <Grid Grid.Column="1" Padding="32,24,32,24">
                    <StackPanel x:Name="ContactDetailPane" Spacing="12" Visibility="Collapsed">
                        <TextBlock x:Name="ContactNameText" Style="{StaticResource TitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE715;" FontSize="14" />
                            <TextBlock x:Name="ContactEmailText" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE717;" FontSize="14" />
                            <TextBlock x:Name="ContactPhoneText" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE731;" FontSize="14" />
                            <TextBlock x:Name="ContactOrgText" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <TextBlock x:Name="ContactNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource AccentButtonStyle}" Click="OnComposeToContactClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE715;" FontSize="14" />
                                    <TextBlock Text="Écrire un message" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnDeleteContactClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Supprimer le contact" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ContactPlaceholder"
                               Text="Sélectionnez un contact pour afficher sa fiche"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>

            <!-- Vue Tâches -->
            <Grid x:Name="TasksViewPane" Visibility="Collapsed" Padding="24,16,24,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tâches" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox x:Name="TaskListChoice" Grid.Column="1" MinWidth="240" VerticalAlignment="Center"
                              SelectionChanged="OnTaskListChanged" ToolTipService.ToolTip="Liste de tâches" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Click="OnRefreshTasksClick" ToolTipService.ToolTip="Actualiser les tâches">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnNewTaskClick"
                                ToolTipService.ToolTip="Nouvelle tâche (Ctrl+Maj+K)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Nouvelle tâche" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- filtres et tri, appliqués localement (ShowTasks) et mémorisés -->
                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="TaskFilterBar" SelectionChanged="OnTaskFilterChanged">
                        <SelectorBarItem Text="Toutes" Tag="all" IsSelected="True" />
                        <SelectorBarItem Text="Aujourd'hui" Tag="today" />
                        <SelectorBarItem Text="En retard" Tag="overdue" />
                        <SelectorBarItem Text="Cette semaine" Tag="week" />
                        <SelectorBarItem Text="Sans date" Tag="nodate" />
                    </SelectorBar>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <ComboBox x:Name="TaskSortChoice" SelectionChanged="OnTaskSortChanged" ToolTipService.ToolTip="Ordre des tâches">
                            <x:String>Trier par échéance</x:String>
                            <x:String>Trier par priorité</x:String>
                        </ComboBox>
                        <CheckBox x:Name="ShowCompletedTasksBox" Content="Afficher les tâches terminées"
                                  IsChecked="True" Click="OnShowCompletedTasksClick" />
                    </StackPanel>
                </Grid>
                <ListView x:Name="TaskList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTaskItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <ProgressRing x:Name="TaskProgress" Grid.Row="2" IsActive="False" Width="32" Height="32" />
            </Grid>

            <!-- Vue Paramètres / Comptes -->
            <ScrollViewer x:Name="SettingsViewPane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,24,32,24" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Comptes de messagerie" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Gérez vos comptes IMAP / SMTP et l'authentification Evolution Data Server."
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}" Click="OnAddAccountClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Ajouter un compte IMAP / SMTP" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ListView x:Name="AccountList" Grid.Row="1" SelectionMode="None" />

                <!-- Confidentialité : contenu externe des messages HTML -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                    <TextBlock Text="Confidentialité" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Les images et styles distants d'un message (dont les pixels de suivi) révèlent à l'expéditeur que vous l'avez ouvert, à quel moment et depuis quelle adresse IP."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <RadioButtons x:Name="RemoteContentModeChoice" Header="Charger le contenu externe des messages"
                                  SelectionChanged="OnRemoteContentModeChanged">
                        <x:String>Jamais</x:String>
                        <x:String>Expéditeurs et domaines de confiance seulement</x:String>
                        <x:String>Toujours</x:String>
                    </RadioButtons>
                    <TextBlock Text="Expéditeurs et domaines de confiance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock x:Name="TrustedSendersEmpty"
                               Text="Aucun expéditeur ni domaine de confiance. Utilisez le bandeau « Contenu externe bloqué » au-dessus d'un message pour en ajouter."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="TrustedSenderList" SelectionMode="None" />
                </StackPanel>
            </Grid>
            </ScrollViewer>
            </Grid>
        </NavigationView>

        <!-- status / errors -->
        <InfoBar x:Name="StatusBar" Grid.Row="2" IsOpen="False" IsClosable="True" />
    </Grid>
</Window>
