                                <!-- Application de messagerie par défaut : liens mailto: -->
                                <TextBlock Text="Liens de messagerie (mailto:)" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,4,0,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                                            <TextBlock Text="Application de messagerie Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Déclare EvolutionWin comme application de messagerie pour que les liens de messagerie (clic sur une adresse dans un navigateur ou un document) ouvrent une nouvelle fenêtre de rédaction. Windows demande ensuite de confirmer le choix dans « Applications par défaut »."
                                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="MailtoStatusText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="MailtoRegisterButton" Content="Enregistrer comme application de messagerie" Click="OnMailtoRegisterClick" />
                                                <Button x:Name="MailtoDefaultAppsButton" Content="Ouvrir les applications par défaut" Click="OnMailtoDefaultAppsClick" />
                                                <Button x:Name="MailtoUnregisterButton" Content="Retirer l'enregistrement" Click="OnMailtoUnregisterClick" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
