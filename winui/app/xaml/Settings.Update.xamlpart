                            <StackPanel x:Name="SettingsCategoryUpdate" Visibility="Collapsed" Spacing="16">

                                <TextBlock Text="Recherche de nouvelles versions" Style="{StaticResource SubtitleTextBlockStyle}" />



                                <!-- Recherche automatique -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Vérifier les mises à jour au démarrage" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Interroger GitHub Releases au lancement pour vous avertir des nouvelles versions."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="UpdateAutoCheckSwitch" Tag="update.auto-check"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>



                                <!-- Canal de mise à jour -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Canal de mise à jour" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Choisissez entre les publications stables recommandées ou les pré-versions de test."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ComboBox Grid.Column="2" x:Name="UpdateChannelCombo" Tag="update.channel"

                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="160">

                                            <ComboBoxItem Content="Stable (Recommandé)" Tag="stable" />

                                            <ComboBoxItem Content="Versions bêta préliminaires" Tag="beta" />

                                        </ComboBox>

                                    </Grid>

                                </Border>



                                <!-- Bouton de vérification manuelle -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE895;" FontSize="20" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Vérifier la disponibilité immédiatement" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Version actuelle installée : 0.9.6 (Architecture Windows x64)"

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <Button Grid.Column="2" Content="Rechercher des mises à jour" Style="{StaticResource AccentButtonStyle}"

                                                Click="OnCheckUpdateNowClick" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>

                            </StackPanel>