                                <TextBlock Text="Semaine de travail et jours ouvrés" Style="{StaticResource SubtitleTextBlockStyle}" />



                                <!-- Calendrier par défaut -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Calendrier par défaut pour les nouveaux événements" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Agenda dans lequel les nouveaux rendez-vous et réunions seront créés par défaut."
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="CalendarDefaultSourceCombo" Tag="calendar.active"
                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="200" />
                                    </Grid>
                                </Border>

                                <!-- Échelle de temps de la grille -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Échelle de temps de la grille" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Pas horaire des sous-divisions pour les vues Jour et Semaine (15, 30 ou 60 minutes)."
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" x:Name="CalendarTimeScaleCombo" Tag="calendar.time-scale"
                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="160">
                                            <ComboBoxItem Content="60 minutes" Tag="60" />
                                            <ComboBoxItem Content="30 minutes (défaut)" Tag="30" />
                                            <ComboBoxItem Content="15 minutes" Tag="15" />
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <!-- Premier jour de la semaine -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Premier jour de la semaine" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Jour à afficher dans la première colonne des vues mensuelle et hebdomadaire."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ComboBox Grid.Column="2" x:Name="CalendarFirstDayCombo" Tag="calendar.first-day"

                                                  SelectionChanged="OnSettingComboChanged" VerticalAlignment="Center" MinWidth="160">

                                            <ComboBoxItem Content="Lundi" Tag="0" />

                                            <ComboBoxItem Content="Dimanche" Tag="1" />

                                            <ComboBoxItem Content="Samedi" Tag="2" />

                                        </ComboBox>

                                    </Grid>

                                </Border>



                                <!-- Jours ouvrés de travail -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Jours de travail de la semaine" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Jours affichés dans la vue « Semaine de travail » et mis en valeur dans la grille."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                            <ToggleButton x:Name="WorkDayMon" Content="Lun" Tag="1" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDayTue" Content="Mar" Tag="2" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDayWed" Content="Mer" Tag="3" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDayThu" Content="Jeu" Tag="4" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDayFri" Content="Ven" Tag="5" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDaySat" Content="Sam" Tag="6" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                            <ToggleButton x:Name="WorkDaySun" Content="Dim" Tag="0" Click="OnCalendarWorkDayToggled" MinWidth="36" />

                                        </StackPanel>

                                    </Grid>

                                </Border>



                                <!-- Heures de travail -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Heures de travail" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Plage horaire habituelle de bureau pour le cadrage du calendrier et les réunions."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                                            <TextBlock Text="De" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <ComboBox x:Name="CalendarWorkStartCombo" Tag="calendar.work-start"

                                                      SelectionChanged="OnSettingComboChanged" MinWidth="90">

                                                <ComboBoxItem Content="06:00" Tag="6" />

                                                <ComboBoxItem Content="07:00" Tag="7" />

                                                <ComboBoxItem Content="08:00" Tag="8" />

                                                <ComboBoxItem Content="08:30" Tag="8.5" />

                                                <ComboBoxItem Content="09:00" Tag="9" />

                                                <ComboBoxItem Content="10:00" Tag="10" />

                                            </ComboBox>

                                            <TextBlock Text="à" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <ComboBox x:Name="CalendarWorkEndCombo" Tag="calendar.work-end"

                                                      SelectionChanged="OnSettingComboChanged" MinWidth="90">

                                                <ComboBoxItem Content="16:00" Tag="16" />

                                                <ComboBoxItem Content="17:00" Tag="17" />

                                                <ComboBoxItem Content="17:30" Tag="17.5" />

                                                <ComboBoxItem Content="18:00" Tag="18" />

                                                <ComboBoxItem Content="18:30" Tag="18.5" />

                                                <ComboBoxItem Content="19:00" Tag="19" />

                                                <ComboBoxItem Content="20:00" Tag="20" />

                                            </ComboBox>

                                        </StackPanel>

                                    </Grid>

                                </Border>



                                <!-- Numéros de semaine -->

                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"

                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"

                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">

                                    <Grid ColumnSpacing="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE890;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                            <TextBlock Text="Afficher les numéros de semaine" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                            <TextBlock Text="Affiche le numéro ISO de la semaine dans le mini-calendrier et les vues du calendrier."

                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                        </StackPanel>

                                        <ToggleSwitch Grid.Column="2" x:Name="CalendarShowWeekNumbersSwitch" Tag="calendar.show-week-numbers"

                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />

                                    </Grid>

                                </Border>

                                <!-- Mini-calendrier latéral -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE787;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Mini-calendrier latéral" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Affiche le sélecteur mensuel rapide dans le volet gauche du calendrier."
                                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="CalendarShowMiniCalendarSwitch" Tag="calendar.show-mini-calendar"
                                                      Toggled="OnSettingToggleChanged" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>