            <Grid x:Name="TasksViewPane" Grid.Row="2" Visibility="Collapsed" Padding="24,16,24,16" RowSpacing="12" ColumnSpacing="16">

                <Grid.ColumnDefinitions>
<ColumnDefinition Width="260" />
<ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
<Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>
<!-- volet des listes de tâches groupées par compte (facon Outlook) -->
<Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" CornerRadius="8" BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
    <Grid RowSpacing="4" Padding="4,12,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Mes tâches" Style="{StaticResource SubtitleTextBlockStyle}" Margin="12,0,12,4" />
        <ListView x:Name="TaskListChoice" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnTaskListChanged"
                  ToolTipService.ToolTip="Liste de tâches" />
    </Grid>
</Border>


                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TaskViewTitle" Text="Toutes les tâches" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />

                    <AutoSuggestBox x:Name="TaskSearchBox" Grid.Column="2" HorizontalAlignment="Right" Width="280"

                                    VerticalAlignment="Center" PlaceholderText="Rechercher une tâche (Ctrl+E)..." QueryIcon="Find"

                                    TextChanged="OnTaskSearchTextChanged" QuerySubmitted="OnTaskSearchQuerySubmitted" />

                </Grid>

                <!-- filtres et tri, appliqués localement (ShowTasks) et mémorisés -->

                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="16">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>

                    <SelectorBar x:Name="TaskFilterBar" SelectionChanged="OnTaskFilterChanged">

                        <SelectorBarItem Text="Toutes" Tag="all" IsSelected="True" />

                        <SelectorBarItem Text="Aujourd'hui" Tag="today" />

                        <SelectorBarItem Text="En retard" Tag="overdue" />

                        <SelectorBarItem Text="Cette semaine" Tag="week" />

                        <SelectorBarItem Text="Sans date" Tag="nodate" />

                    </SelectorBar>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">

                        <Button x:Name="TaskCategoryFilterButton" Click="OnTaskCategoryFilterClick" Padding="8,4" ToolTipService.ToolTip="Filtrer par catégorie">
    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
</Button>
                        <ComboBox x:Name="TaskSortChoice" SelectionChanged="OnTaskSortChanged" ToolTipService.ToolTip="Ordre des tâches">

                            <x:String>Trier par échéance</x:String>

                            <x:String>Trier par priorité</x:String>

                        </ComboBox>

                        <CheckBox x:Name="ShowCompletedTasksBox" Content="Afficher les tâches terminées"

                                  IsChecked="True" Click="OnShowCompletedTasksClick" />

                    </StackPanel>

                </Grid>

                <ListView x:Name="TaskList" Grid.Row="2" Grid.Column="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnTaskItemClick">

                    <ListView.ItemContainerStyle>

                        <Style TargetType="ListViewItem">

                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                        </Style>

                    </ListView.ItemContainerStyle>

                </ListView>

                <ProgressRing x:Name="TaskProgress" Grid.Row="2" Grid.Column="1" IsActive="False" Width="32" Height="32" />

            </Grid>