                <local:PaneSplitter x:Name="FoldersSplitter" Grid.Column="1" Grid.RowSpan="3" Width="8" Background="Transparent"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </local:PaneSplitter>

                <local:PaneSplitter x:Name="ListSplitter" Grid.Column="3" Grid.RowSpan="3" Width="8" Background="Transparent"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                </local:PaneSplitter>