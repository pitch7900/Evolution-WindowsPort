                <local:PaneSplitter x:Name="FoldersSplitter" Grid.Column="1" Grid.RowSpan="3" Width="8" Background="{ThemeResource EvoSidebarBackgroundBrush}"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Tag="evo-line" Width="2" HorizontalAlignment="Right" Fill="{ThemeResource EvoPaneDividerBrush}" />

                    <Rectangle Tag="evo-hover" Width="3" HorizontalAlignment="Right" Opacity="0" IsHitTestVisible="False"
                               RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                </local:PaneSplitter>

                <local:PaneSplitter x:Name="ListSplitter" Grid.Column="3" Grid.RowSpan="3" Width="8" Background="Transparent"

                                    PointerPressed="OnSplitterPointerPressed" PointerMoved="OnSplitterPointerMoved"

                                    PointerReleased="OnSplitterPointerReleased" PointerCaptureLost="OnSplitterPointerCaptureLost"

                                    DoubleTapped="OnSplitterDoubleTapped">

                    <Rectangle Tag="evo-line" Width="2" HorizontalAlignment="Center" Fill="{ThemeResource EvoPaneDividerBrush}" />

                    <Rectangle Tag="evo-hover" Width="3" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                               RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                </local:PaneSplitter>