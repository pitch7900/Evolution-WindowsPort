                                <TextBlock Text="Index de recherche" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

                                <!-- Index plein texte local : activation -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12" MinHeight="64">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="Indexer le contenu des messages" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="Construit sur cet ordinateur un index du corps des messages et des pièces jointes texte (TXT, CSV, HTML, JSON, XML…) pour une recherche instantanée. Seuls les messages déjà téléchargés sont indexés ; les PDF et documents Office ne le sont pas."
                                                       TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="2" x:Name="FullTextIndexSwitch"
                                                      Toggled="OnFullTextIndexToggled" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- État de l'index et reconstruction -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12,16,12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="État de l'index" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="FullTextIndexStatusText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar x:Name="FullTextIndexProgress" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                        <Button x:Name="FullTextIndexRebuildButton" Content="Reconstruire l'index" Click="OnFullTextIndexRebuildClick" />
                                    </StackPanel>
                                </Border>
