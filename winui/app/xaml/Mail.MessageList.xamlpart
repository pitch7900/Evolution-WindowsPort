                <Grid x:Name="MessageListPane" Grid.Column="2" Grid.RowSpan="3" Padding="0,8,0,0">

                    <!-- relève : F5 (courant), F9 (tous les comptes), Maj+F9 (dossier) ; actifs même sans bouton visible -->

                    <Grid.KeyboardAccelerators>

                        <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />

                        <KeyboardAccelerator Key="F9" Invoked="OnRefreshAccelerator" />

                        <KeyboardAccelerator Modifiers="Shift" Key="F9" Invoked="OnRefreshAccelerator" />

                    </Grid.KeyboardAccelerators>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" />

                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="16,0,16,8" Spacing="4">

                        <!-- titre du dossier masqué (redondant avec le volet des dossiers) ; Envoyer/Recevoir : bouton du ruban -->

                        <TextBlock x:Name="FolderTitle" Text="Courrier" Visibility="Collapsed" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <!-- Boîte de réception prioritaire (Microsoft 365) : visible seulement dans la Boîte de réception de ces comptes -->

                        <SelectorBar x:Name="FocusedBar" Visibility="Collapsed" SelectionChanged="OnFocusedBarChanged">
                            <SelectorBarItem x:Name="FocusedBarItemFocused" Text="Prioritaire" Tag="focused" IsSelected="True" />
                            <SelectorBarItem x:Name="FocusedBarItemOther" Text="Autres" Tag="other" />
                        </SelectorBar>

                        <!-- filtres rapides, combinés avec la recherche (appliqués par ShowMessages) -->
                        <Grid>
                            <SelectorBar x:Name="ReadFilterBar" SelectionChanged="OnQuickFilterChanged">
                                <SelectorBarItem x:Name="ReadFilterAll" Text="Tous" Tag="all" IsSelected="True" />
                                <SelectorBarItem x:Name="ReadFilterUnread" Text="Non lus" Tag="unread" />
                                <SelectorBarItem x:Name="ReadFilterRead" Text="Lus" Tag="read" />
                            </SelectorBar>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">

                                <Button x:Name="MailCategoryFilterButton" Click="OnMailCategoryFilterClick" Padding="8,4" ToolTipService.ToolTip="Filtrer par catégorie">
    <FontIcon Glyph="&#xE8EC;" FontSize="13" />
</Button>
                                <ToggleButton x:Name="FlaggedFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Avec indicateur">

                                    <FontIcon Glyph="&#xE7C1;" FontSize="13" />

                                </ToggleButton>

                                <ToggleButton x:Name="AttachmentFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Avec pièces jointes">

                                    <FontIcon Glyph="&#xE723;" FontSize="13" />

                                </ToggleButton>

                                <ToggleButton x:Name="ThisWeekFilterButton" Click="OnQuickFilterToggled"

                                              Padding="8,4" ToolTipService.ToolTip="Cette semaine">

                                    <FontIcon Glyph="&#xE787;" FontSize="13" />

                                </ToggleButton>

                            </StackPanel>

                        </Grid>

                        <!-- tri de la liste (mémorisé par dossier) : MainWindow::SortMessages -->

                        <StackPanel Orientation="Horizontal" Spacing="4">

                            <TextBlock Text="Trier par :" VerticalAlignment="Center" Opacity="0.7"

                                       Style="{StaticResource CaptionTextBlockStyle}" />

                            <DropDownButton x:Name="SortButton" Content="Date" Padding="8,2" FontSize="12"

                                            ToolTipService.ToolTip="Critère de tri">

                                <DropDownButton.Flyout>

                                    <MenuFlyout Opening="OnSortMenuOpening" />

                                </DropDownButton.Flyout>

                            </DropDownButton>

                            <Button x:Name="SortDirectionButton" Click="OnSortDirectionClick" Padding="6,4"

                                    ToolTipService.ToolTip="Inverser l'ordre du tri">

                                <FontIcon x:Name="SortDirectionIcon" Glyph="&#xE74B;" FontSize="12" />

                            </Button>

                            <!-- regroupement (mémorisé par dossier) : MainWindow::OnGroupMenuOpening -->

                            <TextBlock Text="Grouper par :" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"
                                       Style="{StaticResource CaptionTextBlockStyle}" />

                            <DropDownButton x:Name="GroupButton" Content="Aucun" Padding="8,2" FontSize="12"
                                            ToolTipService.ToolTip="Regrouper les messages (Conversation ou Aucun)">
                                <DropDownButton.Flyout>
                                    <MenuFlyout Opening="OnGroupMenuOpening" />
                                </DropDownButton.Flyout>
                            </DropDownButton>

                        </StackPanel>

                    <!-- synchronisation du dossier affiché en cours (MainWindow::SetFolderSyncing) -->
                        <Grid x:Name="FolderSyncBanner" Visibility="Collapsed" Margin="0,6,0,0" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Synchronisation du dossier en cours…" Opacity="0.8"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" />
                        </Grid>

                    </StackPanel>

                    <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="Extended"

                              SelectionChanged="OnMessageSelectionChanged"

                              DoubleTapped="OnMessageListDoubleTapped"

                              KeyDown="OnMessageListKeyDown"
                              CanDragItems="True"
                              ContainerContentChanging="OnMessageListContainerChanging"
                              DragItemsStarting="OnMessageListDragItemsStarting"
                              DragItemsCompleted="OnMessageListDragItemsCompleted">

                        <ListView.ItemContainerStyle>

                            <Style TargetType="ListViewItem">

                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            </Style>

                        </ListView.ItemContainerStyle>

                    </ListView>

                    <ProgressRing x:Name="ListProgress" Grid.Row="1" IsActive="False"

                                  Width="32" Height="32" />

                </Grid>