                <Grid Grid.Column="0" Grid.RowSpan="3" Padding="4,8,4,8">

                    <TreeView x:Name="FolderTree" SelectionMode="Single"

                              ItemInvoked="OnFolderInvoked">

                        <!-- nodes hold a FolderItem in their Content -->

                        <TreeView.ItemTemplate>

                            <DataTemplate>

                                <TreeViewItem>

                                    <Grid ColumnSpacing="8">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <FontIcon Glyph="{Binding Content.Glyph}"

                                                  FontFamily="{Binding Content.GlyphFontFamily}"

                                                  FontSize="14" />

                                        <TextBlock Grid.Column="1" Text="{Binding Content.Name}" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2" Text="{Binding Content.UnreadText}"

                                                   Margin="0,0,12,0"

                                                   FontWeight="SemiBold"

                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                    </Grid>

                                </TreeViewItem>

                            </DataTemplate>

                        </TreeView.ItemTemplate>

                    </TreeView>

                </Grid>