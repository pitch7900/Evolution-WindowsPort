                            <StackPanel x:Name="SettingsCategoryAbout" Visibility="Collapsed" Spacing="16">

                                <!-- Carte 1 : En-tête version et recherche de mise à jour -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Logo de l'application -->
                                            <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                <Image x:Name="AboutAppLogo" Source="Assets/EvolutionWin.png" Width="64" Height="64" Stretch="UniformToFill" />
                                            </Border>

                                            <!-- Titre et informations de version -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                <TextBlock Text="Evolution pour Windows" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold" FontSize="20" />
                                                <TextBlock x:Name="AboutVersionText" Text="Version 0.9.6"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock x:Name="AboutUpdateStatusText" Text="Recherche de mises à jour…"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <!-- Action manuelle de vérification -->
                                            <Button Grid.Column="2" x:Name="AboutCheckUpdateButton" VerticalAlignment="Center" Click="OnAboutCheckUpdateClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE777;" FontSize="14" />
                                                    <TextBlock Text="Rechercher des mises à jour" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Bandeau d'information si une mise à jour est trouvée ou en cas d'erreur -->
                                        <InfoBar x:Name="AboutUpdateInfoBar" IsClosable="True" IsOpen="False" />
                                    </StackPanel>
                                </Border>

                                <!-- Carte 2 : Présentation et mentions légales -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="Présentation et mentions légales" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="Client de messagerie, calendrier et contacts complet natif pour Windows 11, bâti sur le moteur robuste de GNOME Evolution (evolution-data-server, Camel), Windows App SDK et WinUI 3. Logiciel libre sous licence GNU LGPL 2.1 ou ultérieure."
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                                            <HyperlinkButton Content="Dépôt GitHub du portage" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort" Padding="0" />
                                            <HyperlinkButton Content="Journal des modifications (CHANGELOG)" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort/blob/main/CHANGELOG.md" Padding="0" />
                                            <HyperlinkButton Content="Signaler une anomalie" NavigateUri="https://github.com/pitch7900/Evolution-WindowsPort/issues" Padding="0" />
                                            <HyperlinkButton Content="Dépôt amont GNOME Evolution" NavigateUri="https://github.com/GNOME/evolution" Padding="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Carte 3 : Composants du moteur et environnement technique -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="20">
                                    <StackPanel Spacing="16">
                                        <Grid>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Composants et environnement système" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="Versions des bibliothèques intégrées et du système d'exploitation pour le diagnostic."
                                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button x:Name="AboutCopySystemInfoButton" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnAboutCopySystemInfoClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                                    <TextBlock x:Name="AboutCopySystemInfoButtonText" Text="Copier les informations" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Grille des composants (peuplée dynamiquement) -->
                                        <Grid x:Name="AboutComponentsGrid" ColumnSpacing="24" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>