<?xml version="1.0" encoding="utf-8"?>
<!--
  Installeur MSI d'EvolutionWin (WiX v5), construit par tools\build-msi.bat.
  Variables : StageDir (arborescence préparée par build-msi.ps1), Version.

  Installation par machine dans %ProgramFiles%\Evolution ; déploiement
  silencieux : msiexec /i Evolution-<version>-x64.msi /qn
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Evolution"
           Manufacturer="Evolution-WindowsPort"
           Version="$(var.Version)"
           UpgradeCode="265A2473-73C6-4E13-85B8-D3B54853A588"
           Scope="perMachine"
           Language="1036"
           Codepage="1252"
           Compressed="yes">
    <SummaryInformation Description="Evolution pour Windows (client natif WinUI 3)" />

    <!-- UpgradeCode fixe : une nouvelle version remplace la précédente ;
         même version autorisée pour réinstaller une compilation de test -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="Une version plus récente d'Evolution est déjà installée." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Mise à jour / désinstallation pendant qu'Evolution tourne : sans cela,
         Windows Installer affiche « fichiers en cours d'utilisation » (souvent
         caché derrière l'Explorateur ; une seconde installation lancée entre-temps
         échoue alors avec l'erreur 1618). EvolutionWin est invité à se fermer,
         puis arrêté ; les services EDS (sans fenêtre) sont arrêtés, EvolutionWin
         les redémarre au besoin. -->
    <util:CloseApplication Id="CloseEvolutionWin" Target="EvolutionWin.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           Description="Fermeture d'Evolution"
                           CloseMessage="yes" ElevatedCloseMessage="yes"
                           Timeout="5" TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseSourceRegistry" Target="evolution-source-registry.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseAddressBookFactory" Target="evolution-addressbook-factory.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseAddressBookSubprocess" Target="evolution-addressbook-factory-subprocess.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseCalendarFactory" Target="evolution-calendar-factory.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseCalendarSubprocess" Target="evolution-calendar-factory-subprocess.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />
    <util:CloseApplication Id="CloseSessionBus" Target="gdbus.exe" Condition="FORCECLOSE &lt;&gt; &quot;0&quot;"
                           TerminateProcess="1" RebootPrompt="no" />

    <!-- Propriété publique FORCECLOSE (non déclarée : vide = « 1 », comportement historique) :
           msiexec /i Evolution-<version>-x64.msi /qn FORCECLOSE=1
         ferme EvolutionWin, les services EDS et leurs dépendances avant de remplacer
         les fichiers ; FORCECLOSE=0 désactive toute fermeture (fichiers verrouillés :
         remplacement au redémarrage, code de sortie 3010). Pas de boîte de
         confirmation « Fermer Evolution ? » : le MSI n'a volontairement aucune interface
         personnalisée (voir deploy\DEPLOIEMENT.md). -->

    <!-- Fermeture, dans TOUTES les sessions, des dépendances que CloseApplication ne sait
         pas viser : camel-index-control, gspawn-win64-helper et les processus
         msedgewebview2.exe du dossier de données d'EvolutionWin (script source :
         deploy\msi\close-dependencies.ps1, passé en base64 par build-msi.ps1). -->
    <CustomAction Id="CloseDependencies" Directory="SystemFolder" Return="ignore"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $(var.CloseDepsB64)" />

    <!-- Nettoyage des données de l'utilisateur à la désinstallation, sur demande :
           msiexec /x Evolution-<version>-x64.msi PURGEUSERDATA=1
         Jamais lors d'une mise à jour (UPGRADINGPRODUCTCODE). Journal : %TEMP%\EvolutionWin-purge.log
         (script source : deploy\msi\purge-userdata.ps1). -->
    <Property Id="PURGEUSERDATA" Value="0" />
    <CustomAction Id="PurgeUserData" Directory="SystemFolder" Return="ignore"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $(var.PurgeUserDataB64)" />
    <!-- Chemin du journal de purge : posé en propriété pour apparaître dans le journal MSI (/l*v)
         (« PROPERTY CHANGE: Adding PURGELOG property ») quand la purge est demandée. -->
    <SetProperty Id="PURGELOG" Value="[TempFolder]EvolutionWin-purge.log" Before="PurgeUserData" Sequence="execute"
                 Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PURGEUSERDATA="1"' />

    <!-- Propriétés facultatives (déploiement) :
           AUTOUPDATE=0       écrit la stratégie HKLM\SOFTWARE\Policies\EvolutionWin\DisableAutoUpdate = 1
           REGISTERMAILTO=1   enregistre EvolutionWin comme application de messagerie (mailto:) pour la machine -->
    <Property Id="REGISTERMAILTO" Value="0" />

    <InstallExecuteSequence>
      <Custom Action="CloseDependencies" Before="InstallValidate" Condition='FORCECLOSE &lt;&gt; "0"' />
      <Custom Action="PurgeUserData" After="InstallInitialize"
              Condition='REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND PURGEUSERDATA="1"' />
    </InstallExecuteSequence>

    <!-- Runtime Edge WebView2 (inclus dans Windows 11) : lecture et
         rédaction des messages -->
    <Property Id="WEBVIEW2_MACHINE">
      <RegistrySearch Root="HKLM" Bitness="always32" Type="raw" Name="pv"
                      Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" />
    </Property>
    <Property Id="WEBVIEW2_USER">
      <RegistrySearch Root="HKCU" Type="raw" Name="pv"
                      Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" />
    </Property>
    <!-- "0.0.0.0" : runtime désinstallé -->
    <Launch Condition='Installed OR (WEBVIEW2_MACHINE AND WEBVIEW2_MACHINE &lt;&gt; "0.0.0.0") OR (WEBVIEW2_USER AND WEBVIEW2_USER &lt;&gt; "0.0.0.0")'
            Message="Evolution nécessite le runtime Microsoft Edge WebView2 (https://go.microsoft.com/fwlink/p/?LinkId=2124703)." />

    <!-- icône dans « Applications installées » (celle des raccourcis vient de l'exécutable) -->
    <Icon Id="EvolutionWin.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="EvolutionWin.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/pitch7900/Evolution-WindowsPort" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Désactivation de Restart Manager pour éviter les invites bloquantes lors des mises à jour silencieuses -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- Lancement automatique post-installation si demandé (ex: msiexec /i ... LAUNCHAPP=1) -->
    <Property Id="LAUNCHAPP" Value="0" />
    <CustomAction Id="LaunchApplication"
                  Directory="BINFOLDER"
                  ExeCommand="[#EvolutionWinExe]"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition='LAUNCHAPP = "1" AND NOT Installed' />
    </InstallExecuteSequence>

    <!-- Choix de la langue par défaut : propriété publique UILANGUAGE pour déploiement silencieux (GPO/Intune)
         ou préremplie par défaut. Écrite dans HKLM\Software\Evolution-WindowsPort\UILanguage -->
    <Property Id="UILANGUAGE" Value="fr-FR" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Evolution">
        <Directory Id="BINFOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Evolution" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="EvolutionWinExe" />
      <ComponentRef Id="RegistryUILanguage" />
      <ComponentRef Id="RegistryDisableAutoUpdate" />
      <ComponentRef Id="RegistryMailto" />
    </Feature>
  </Package>

  <Fragment>
    <!-- Configuration de la langue par défaut dans la base de registre machine (HKLM) -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RegistryUILanguage" Guid="D2A6B347-49F1-4F98-8DE2-482EEB96A889">
        <RegistryKey Root="HKLM" Key="Software\Evolution-WindowsPort">
          <RegistryValue Type="string" Name="UILanguage" Value="[UILANGUAGE]" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <!-- AUTOUPDATE=0 : stratégie « mises à jour désactivées » (lue par Policy.h) -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="RegistryDisableAutoUpdate" Guid="7B1E5C0A-3D52-4E0B-9A6F-5C2D8E41B7A3" Condition='AUTOUPDATE = "0"'>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Policies\EvolutionWin">
          <RegistryValue Type="integer" Name="DisableAutoUpdate" Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <!-- REGISTERMAILTO=1 : mêmes clés que winui/app/Mailto.h (HKCU de l'application), côté machine.
           L'utilisateur choisit ensuite EvolutionWin dans « Applications par défaut ». -->
      <Component Id="RegistryMailto" Guid="E4C8A1F2-6B97-4D35-8F0C-1A9B3D7E5C60" Condition='REGISTERMAILTO = "1"'>
        <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\Mail\EvolutionWin">
          <RegistryValue Type="string" Value="Evolution" KeyPath="yes" />
          <RegistryKey Key="Capabilities">
            <RegistryValue Type="string" Name="ApplicationName" Value="Evolution" />
            <RegistryValue Type="string" Name="ApplicationDescription" Value="Courrier, calendrier et contacts" />
            <RegistryKey Key="URLAssociations">
              <RegistryValue Type="string" Name="mailto" Value="EvolutionWin.Url.mailto" />
            </RegistryKey>
          </RegistryKey>
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[BINFOLDER]EvolutionWin.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[BINFOLDER]EvolutionWin.exe&quot;" />
          </RegistryKey>
        </RegistryKey>
        <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="EvolutionWin"
                       Type="string" Value="SOFTWARE\Clients\Mail\EvolutionWin\Capabilities" />
        <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\EvolutionWin.Url.mailto">
          <RegistryValue Type="string" Value="URL:MailTo Protocol" />
          <RegistryValue Type="string" Name="URL Protocol" Value="" />
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string" Value="[BINFOLDER]EvolutionWin.exe,0" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[BINFOLDER]EvolutionWin.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <!-- tout le contenu de l'arborescence préparée, sous-dossiers compris,
         sauf l'exécutable principal déclaré ci-dessous -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**">
        <Exclude Files="$(var.StageDir)\bin\EvolutionWin.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!-- raccourci du menu Démarrer (tous les utilisateurs) porté par le
         fichier lui-même : clé du composant = l'exécutable, par machine -->
    <DirectoryRef Id="BINFOLDER">
      <Component Id="EvolutionWinExe">
        <File Id="EvolutionWinExe" Source="$(var.StageDir)\bin\EvolutionWin.exe" KeyPath="yes">
          <Shortcut Id="EvolutionShortcut"
                    Directory="ProgramMenuFolder"
                    Name="Evolution"
                    Description="Courrier, calendrier et contacts"
                    WorkingDirectory="BINFOLDER"
                    Advertise="no" />
        </File>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
